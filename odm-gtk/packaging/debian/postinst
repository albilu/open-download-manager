#!/bin/bash
# Post-installation script for open-download-manager
# This script sets up the application environment
# Version requirements are handled by package manager through debian/control

set -e

echo fs.inotify.max_user_watches=524288 | tee -a /etc/sysctl.conf && sysctl -p

# Configuration
PACKAGE_NAME="open-download-manager"
LOG_FILE="/var/log/odm-install.log"

# Logging function
log() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" | tee -a "$LOG_FILE"
}

# Check if tools are available for informational purposes
check_tool_availability() {
    local tools=("aria2c" "curl" "yt-dlp" "httrack" "proxychains4")

    log "Checking tool availability (versions enforced by package manager):"

    for tool in "${tools[@]}"; do
        if command -v "$tool" >/dev/null 2>&1; then
            log "  ✅ $tool: Available"
        else
            log "  ❌ $tool: Not found"
        fi
    done
}

# Create application directories
setup_directories() {
    log "Setting up application directories..."

    # System directories
    mkdir -p /etc/odm
    mkdir -p /var/lib/odm
    mkdir -p /var/log/odm

    # Set permissions
    chmod 755 /etc/odm /var/lib/odm
    chmod 750 /var/log/odm

    # Create default configuration if it doesn't exist
    if [[ ! -f /etc/odm/odm.conf ]]; then
        cat > /etc/odm/odm.conf << 'EOF'
# Open Download Manager Configuration
# This file contains system-wide settings

# Tool paths (auto-discovered if not specified)
#aria2.path=/usr/bin/aria2c
#curl.path=/usr/bin/curl
#yt-dlp.path=/usr/bin/yt-dlp
#httrack.path=/usr/bin/httrack
#proxychains.path=/usr/bin/proxychains4

# Default download settings
downloads.max-concurrent=3
downloads.default-connections=4
downloads.timeout=30

# Logging
logging.level=INFO
logging.file=/var/log/odm/odm.log
EOF
        chmod 644 /etc/odm/odm.conf
    fi

    log "✅ Directories created successfully"
}

# Create desktop integration
setup_desktop_integration() {
    log "Setting up desktop integration..."

    # Create .desktop file
    cat > /usr/share/applications/open-download-manager.desktop << EOF
[Desktop Entry]
Name=Open Download Manager
Comment=Full-featured download manager for Linux
Exec=java -jar /usr/share/java/open-download-manager.jar
Icon=open-download-manager
Terminal=false
Type=Application
Categories=Network;FileTransfer;
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
Keywords=download;torrent;aria2;yt-dlp;
EOF

    # Update desktop database
    if command -v update-desktop-database >/dev/null 2>&1; then
        update-desktop-database /usr/share/applications
    fi

    log "✅ Desktop integration configured"
}

# Create executable launcher
setup_launcher() {
    log "Setting up launcher script..."

    # Create executable launcher script
    cat > /usr/bin/open-download-manager << 'EOF'
#!/bin/sh
# Open Download Manager launcher script
exec java -jar /usr/share/java/open-download-manager.jar "$@"
EOF

    chmod +x /usr/bin/open-download-manager

    log "✅ Launcher script created at /usr/bin/open-download-manager"
}

# Main installation logic
main() {
    log "=== Open Download Manager Post-Installation ==="
    log "Starting post-installation setup for $PACKAGE_NAME"

    # Check tool availability (informational only - versions enforced by package manager)
    check_tool_availability

    # Setup application
    setup_directories
    setup_desktop_integration
    setup_launcher

    log "✅ Installation setup completed successfully"
    log "🚀 Open Download Manager is ready to use!"
    log ""
    log "Usage:"
    log "  • Command line: open-download-manager"
    log "  • Applications menu: Open Download Manager"
    log "  • Direct JAR: java -jar /usr/share/java/open-download-manager.jar"
    log ""
    log "Configuration file: /etc/odm/odm.conf"
    log "Log files: /var/log/odm/"
    log ""
    log "Note: All dependency versions are managed by the package manager."
    log "If you encounter issues, please check that all dependencies are properly installed."
    log "=== Installation completed successfully ==="
}

# Only run if being installed (not during package build)
case "$1" in
    configure)
        main "$@"
        ;;
    abort-upgrade|abort-remove|abort-deconfigure)
        log "Installation aborted: $1"
        exit 0
        ;;
    *)
        log "Unknown postinst argument: $1"
        exit 0
        ;;
esac

exit 0
