# Maintainer: ODM Development Team <dev@odm-project.org>
pkgname=open-download-manager
pkgver=0.1.0
pkgrel=1
pkgdesc="Full-featured download manager for Linux based on aria2, yt-dlp and httrack"
arch=('any')
url="https://github.com/odm-project/open-download-manager"
license=('GPL3')
depends=(
    'java-runtime>=21'
    'aria2>=1.34.0' 'aria2<=1.37.0'
    'curl>=7.50.0' 'curl<8.6.0'
    'yt-dlp>=2023.01.01' 'yt-dlp<2025.01.01'
    'httrack>=3.49.0' 'httrack<3.50.0'
    'proxychains-ng>=4.14.0' 'proxychains-ng<4.17.0'
)
optdepends=(
    'tor: anonymous downloads'
    'ffmpeg: video processing'
    'python-pip: additional yt-dlp plugins'
)
makedepends=(
    'jdk11-openjdk'
    'maven>=3.6.0'
)
conflicts=(
    'aria2<1.34.0' 'aria2>=1.37.0'
    'curl<7.50.0' 'curl>=8.6.0'
    'yt-dlp<2023.01.01' 'yt-dlp>=2025.01.01'
    'httrack<3.49.0' 'httrack>=3.50.0'
    'proxychains-ng<4.14.0' 'proxychains-ng>=4.17.0'
)
source=("${pkgname}-${pkgver}.tar.gz::${url}/archive/v${pkgver}.tar.gz")
sha256sums=('SKIP')  # Update with actual checksum

prepare() {
    cd "${pkgname}-${pkgver}"

    # Validate that we can build with current tools
    echo "=== Build-time Dependency Check ==="

    # Check Java
    if ! java -version 2>&1 | grep -q "11\|17\|21"; then
        error "java 21+ is required for building"
        return 1
    fi

    # Check Maven
    if ! command -v mvn >/dev/null 2>&1; then
        error "Maven is required for building"
        return 1
    fi

    echo "✅ Build dependencies satisfied"
}

build() {
    cd "${pkgname}-${pkgver}"

    # Build with Maven
    echo "Building Open Download Manager..."
    mvn clean package -DskipTests

    # Verify JAR was created
    if [[ ! -f target/open-download-manager-*.jar ]]; then
        error "Build failed - JAR file not found"
        return 1
    fi

    echo "✅ Build completed successfully"
}

check() {
    cd "${pkgname}-${pkgver}"

    # Basic validation - ensure JAR can be executed
    local jar_file=$(find target -name "open-download-manager-*.jar" -type f | head -1)
    if [[ -n "$jar_file" ]]; then
        java -jar "$jar_file" --version >/dev/null 2>&1 || {
            warning "JAR validation failed - continuing anyway"
        }
    fi
}

package() {
    cd "${pkgname}-${pkgver}"

    # Create directories
    install -dm755 "${pkgdir}/usr/share/java"
    install -dm755 "${pkgdir}/usr/bin"
    install -dm755 "${pkgdir}/usr/share/applications"
    install -dm755 "${pkgdir}/etc/odm"
    install -dm755 "${pkgdir}/var/lib/odm"
    install -dm755 "${pkgdir}/var/log/odm"
    install -dm755 "${pkgdir}/usr/share/doc/${pkgname}"

    # Install JAR file
    local jar_file=$(find target -name "open-download-manager-*.jar" -type f | head -1)
    install -Dm644 "$jar_file" "${pkgdir}/usr/share/java/${pkgname}.jar"

    # Create launcher script
    cat > "${pkgdir}/usr/bin/odm" << 'EOF'
#!/bin/bash
# Open Download Manager launcher script

# Configuration
JAR_PATH="/usr/share/java/open-download-manager.jar"
CONFIG_FILE="/etc/odm/odm.conf"
LOG_DIR="/var/log/odm"

# Ensure log directory exists and is writable
if [[ ! -d "$LOG_DIR" ]]; then
    mkdir -p "$LOG_DIR" 2>/dev/null || LOG_DIR="$HOME/.odm/logs"
fi

# Java options
JAVA_OPTS="-Xmx512m -Djava.awt.headless=false"

# Add configuration file if it exists
if [[ -f "$CONFIG_FILE" ]]; then
    JAVA_OPTS="$JAVA_OPTS -Dodm.config=$CONFIG_FILE"
fi

# Launch application
exec java $JAVA_OPTS -jar "$JAR_PATH" "$@"
EOF
    chmod 755 "${pkgdir}/usr/bin/odm"

    # Install desktop file
    cat > "${pkgdir}/usr/share/applications/${pkgname}.desktop" << 'EOF'
[Desktop Entry]
Name=Open Download Manager
Comment=Full-featured download manager for Linux
Exec=odm
Icon=open-download-manager
Terminal=false
Type=Application
Categories=Network;FileTransfer;
MimeType=application/x-bittorrent;x-scheme-handler/magnet;
Keywords=download;torrent;aria2;yt-dlp;
StartupNotify=true
EOF

    # Create default configuration
    cat > "${pkgdir}/etc/odm/odm.conf" << 'EOF'
# Open Download Manager Configuration
# This file contains system-wide settings

# Tool paths (auto-discovered if not specified)
#aria2.path=/usr/bin/aria2c
#curl.path=/usr/bin/curl
#yt-dlp.path=/usr/bin/yt-dlp
#httrack.path=/usr/bin/httrack
#proxychains.path=/usr/bin/proxychains4

# Default download settings
downloads.max-concurrent=3
downloads.default-connections=4
downloads.timeout=30

# Logging
logging.level=INFO
logging.file=/var/log/odm/odm.log
EOF

    # Install documentation
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
    [[ -f LICENSE ]] && install -Dm644 LICENSE "${pkgdir}/usr/share/doc/${pkgname}/LICENSE"

    # Create post-install validation script
    cat > "${pkgdir}/usr/share/doc/${pkgname}/validate-dependencies.sh" << 'SCRIPT'
#!/bin/bash
# Dependency validation script for Open Download Manager

set -e

# Tool version requirements (minimum and maximum tested versions)
declare -A MIN_VERSIONS=(
    ["aria2"]="1.34.0"
    ["curl"]="7.50.0"
    ["yt-dlp"]="2023.01.01"
    ["httrack"]="3.49.0"
    ["proxychains-ng"]="4.14.0"
)

declare -A MAX_VERSIONS=(
    ["aria2"]="1.36.99"
    ["curl"]="8.5.99"
    ["yt-dlp"]="2024.12.31"
    ["httrack"]="3.49.99"
    ["proxychains-ng"]="4.16.99"
)

# Tool commands
declare -A TOOL_COMMANDS=(
    ["aria2"]="aria2c"
    ["curl"]="curl"
    ["yt-dlp"]="yt-dlp"
    ["httrack"]="httrack"
    ["proxychains-ng"]="proxychains4"
)

# Version comparison using pacman
version_ge() {
    local v1="$1" v2="$2"
    # Remove non-numeric prefixes and suffixes
    v1=$(echo "$v1" | sed 's/^[^0-9]*//; s/[^0-9.]*$//')
    v2=$(echo "$v2" | sed 's/^[^0-9]*//; s/[^0-9.]*$//')

    # Use vercmp from pacman if available
    if command -v vercmp >/dev/null 2>&1; then
        local result=$(vercmp "$v1" "$v2")
        [[ $result -ge 0 ]]
        return $?
    fi

    # Fallback comparison
    python -c "
import sys
from packaging import version
try:
    result = version.parse('$v1') >= version.parse('$v2')
    sys.exit(0 if result else 1)
except:
    sys.exit(0)
" 2>/dev/null || return 0
}

# Get tool version
get_tool_version() {
    local tool="$1"
    local command="${TOOL_COMMANDS[$tool]}"

    if ! command -v "$command" >/dev/null 2>&1; then
        return 1
    fi

    case "$tool" in
        "aria2")
            "$command" --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
            ;;
        "curl")
            "$command" --version 2>/dev/null | head -n1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
            ;;
        "yt-dlp")
            "$command" --version 2>/dev/null | grep -oE '[0-9]{4}\.[0-9]{2}\.[0-9]{2}' | head -n1
            ;;
        "httrack")
            "$command" --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -n1
            ;;
        "proxychains-ng")
            "$command" 2>&1 | grep -i version | grep -oE '[0-9]+\.[0-9]+' | head -n1
            ;;
    esac
}

echo "=== Open Download Manager Dependency Validation ==="
validation_failed=false

for tool in "${!MIN_VERSIONS[@]}"; do
    required="${MIN_VERSIONS[$tool]}"
    command="${TOOL_COMMANDS[$tool]}"

    if ! command -v "$command" >/dev/null 2>&1; then
        if [[ "$tool" == "aria2" || "$tool" == "curl" ]]; then
            echo "❌ $tool: REQUIRED tool not found"
            validation_failed=true
        else
            echo "⚠️  $tool: Optional tool not found"
        fi
        continue
    fi

    current_version=$(get_tool_version "$tool")
    if [[ -z "$current_version" ]]; then
        echo "⚠️  $tool: Could not determine version"
        continue
    fi

    if ! version_ge "$current_version" "$required"; then
        echo "❌ $tool: Version $current_version < required $required"
        if [[ "$tool" == "aria2" || "$tool" == "curl" ]]; then
            validation_failed=true
        fi
    else
        # Check maximum version
        local max_version="${MAX_VERSIONS[$tool]}"
        if [[ -n "$max_version" ]] && version_ge "$current_version" "$max_version"; then
            echo "⚠️  $tool: Version $current_version > tested $max_version (may cause compatibility issues)"
        else
            echo "✅ $tool: Version $current_version (OK)"
        fi
    fi
done

if [[ "$validation_failed" == "true" ]]; then
    echo ""
    echo "❌ Dependency validation failed!"
    echo "Install missing dependencies:"
    echo "  pacman -S aria2 curl yt-dlp httrack proxychains-ng"
    exit 1
fi

echo ""
echo "✅ All dependencies validated successfully"
echo "🚀 Open Download Manager is ready to use!"
echo ""
echo "Usage:"
echo "  odm                    # Launch GUI"
echo "  java -jar /usr/share/java/open-download-manager.jar"
echo ""
echo "Configuration: /etc/odm/odm.conf"
echo "Logs: /var/log/odm/"

SCRIPT
    chmod 755 "${pkgdir}/usr/share/doc/${pkgname}/validate-dependencies.sh"
}

# Post-install message
post_install() {
    echo ""
    echo "=== Open Download Manager Installation Complete ==="
    echo ""
    echo "Running dependency validation..."
    /usr/share/doc/open-download-manager/validate-dependencies.sh
    echo ""
    echo "Configuration file: /etc/odm/odm.conf"
    echo "Documentation: /usr/share/doc/open-download-manager/"
    echo ""
    echo "To launch: odm"
    echo "Or from applications menu: Open Download Manager"
}

post_upgrade() {
    post_install
}

pre_remove() {
    echo "Removing Open Download Manager..."
    # Stop any running instances
    pkill -f "open-download-manager.jar" 2>/dev/null || true
}
