package org.manager.clipboard;

import java.awt.Toolkit;
import java.awt.datatransfer.Clipboard;
import java.awt.datatransfer.StringSelection;
import java.net.URI;
import java.nio.file.Files;
import java.nio.file.Path;
import java.time.Duration;
import java.util.List;
import java.util.concurrent.TimeUnit;
import java.util.concurrent.atomic.AtomicInteger;
import java.util.concurrent.atomic.AtomicReference;
import org.awaitility.Awaitility;
import org.junit.jupiter.api.AfterEach;
import static org.junit.jupiter.api.Assertions.*;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.DisplayName;
import org.junit.jupiter.api.Nested;
import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.Timeout;
import org.junit.jupiter.api.condition.EnabledOnOs;
import org.junit.jupiter.api.condition.OS;
import org.junit.jupiter.params.ParameterizedTest;
import org.junit.jupiter.params.provider.ValueSource;
import org.manager.ComponentFactory;
import org.manager.GlobalSettings;
import org.manager.download.Download;
import org.manager.download.DownloadManager;

/**
 * End-to-end tests for clipboard functionality. These tests verify the complete
 * clipboard workflow from URL detection to download creation. Note: These tests
 * require a GUI environment and may not work in headless CI environments.
 */
@DisplayName("Clipboard End-to-End Tests")
class ClipboardE2ETest {

    private ComponentFactory componentFactory;
    private ClipboardService clipboardService;
    private DownloadManager downloadManager;
    private Path tempDownloadDir;
    private GlobalSettings globalSettings;

    @BeforeEach
    void setUp() throws Exception {
        // Create temporary download directory
        tempDownloadDir = Files.createTempDirectory("clipboard-e2e-test");

        // Setup component factory with custom settings
        globalSettings = new GlobalSettings()
                .setDefaultDownloadDirectory(tempDownloadDir)
                .setMaxConcurrentDownloads(2);

        // Configure clipboard settings
        ClipboardSettings clipboardSettings = new ClipboardSettings()
                .setMonitoringEnabled(true)
                .setMonitoringIntervalMs(200) // Faster for testing
                .setSilentMode(true)
                .setAutoDownloadDetectedUrls(false) // Manual control for testing
                .setFilterVideoUrls(true)
                .setFilterTorrentUrls(true)
                .setFilterDirectDownloads(true)
                .setMaxUrlsPerClipboard(5);

        globalSettings.setClipboardSettings(clipboardSettings);

        // Create component factory
        componentFactory = ComponentFactory.create(globalSettings);
        clipboardService = componentFactory.getClipboardService();
        downloadManager = componentFactory.createDownloadManager();
    }

    @AfterEach
    void tearDown() throws Exception {
        if (clipboardService != null) {
            clipboardService.cleanup();
        }
        if (componentFactory != null) {
            componentFactory.shutdown();
        }
        if (tempDownloadDir != null && Files.exists(tempDownloadDir)) {
            Files.deleteIfExists(tempDownloadDir);
        }
    }

    @Nested
    @DisplayName("Real Clipboard Integration")
    @EnabledOnOs({OS.LINUX})
    class RealClipboardIntegrationTest {

        @Test
        @DisplayName("Should detect URLs from system clipboard")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testRealClipboardUrlDetection() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);
            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String testUrl = "https://example.com/test-file.zip";

            // When - simulate copying URL to system clipboard
            setSystemClipboard(testUrl);

            // Then - wait for URL detection
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            assertEquals(1, listener.urlsDetectedCount.get());
            assertNotNull(listener.lastDetectedUrls.get());
            assertEquals(1, listener.lastDetectedUrls.get().size());
            assertTrue(listener.lastDetectedUrls.get().get(0).toString().contains("example.com"));
        }

        @Test
        @DisplayName("Should handle multiple URLs in clipboard")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testMultipleUrlsInClipboard() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);
            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String multipleUrls = "Download these files:\n"
                    + "https://example.com/file1.zip\n"
                    + "https://test.org/file2.exe\n"
                    + "https://download.site/archive.tar.gz";

            // When
            setSystemClipboard(multipleUrls);

            // Then
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            assertEquals(1, listener.urlsDetectedCount.get());
            assertNotNull(listener.lastDetectedUrls.get());
            assertEquals(3, listener.lastDetectedUrls.get().size());
        }

        @Test
        @DisplayName("Should ignore clipboard changes without URLs")
        @Timeout(value = 10, unit = TimeUnit.SECONDS)
        void testIgnoreNonUrlContent() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);
            clipboardService.startService().get(5, TimeUnit.SECONDS);

            // When - set clipboard to non-URL content
            setSystemClipboard("This is just plain text without any download links");

            // Then - wait and verify no URL detection
            Thread.sleep(2000); // Wait for potential detection

            assertEquals(0, listener.urlsDetectedCount.get());
        }

        @Test
        @DisplayName("Should handle clipboard content with mixed text and URLs")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testMixedContentClipboard() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);
            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String mixedContent = "Hello, please download the software from "
                    + "https://example.com/software.zip for installation. "
                    + "Also check the documentation at https://docs.example.com/guide.pdf. "
                    + "The source code is available too.";

            // When
            setSystemClipboard(mixedContent);

            // Then
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            assertEquals(1, listener.urlsDetectedCount.get());
            assertEquals(2, listener.lastDetectedUrls.get().size());
        }
    }

    @Nested
    @DisplayName("Complete Workflow Tests")
    class CompleteWorkflowTest {

        @Test
        @DisplayName("Should complete full workflow from clipboard to download creation")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testCompleteWorkflow() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            // Update settings to enable auto-download
            ClipboardSettings settings = clipboardService.getSettings();
            settings.setAutoDownloadDetectedUrls(true);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String testUrl = "https://httpbin.org/bytes/1024"; // Real URL for testing

            // When
            setSystemClipboard(testUrl);

            // Then - wait for URL detection and download creation
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            // Verify download was created
            List<Download> downloads = downloadManager.getAllDownloads();
            assertTrue(downloads.size() > 0, "At least one download should be created");

            Download createdDownload = downloads.get(0);
            assertNotNull(createdDownload);
            assertTrue(createdDownload.getUri().toString().contains("httpbin.org"));
        }

        @Test
        @DisplayName("Should handle video URLs with yt-dlp download type")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testYouTubeUrlWorkflow() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setAutoDownloadDetectedUrls(true)
                    .setFilterVideoUrls(true);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String youtubeUrl = "https://www.youtube.com/watch?v=dQw4w9WgXcQ";

            // When
            setSystemClipboard(youtubeUrl);

            // Then
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            // Verify YouTube download was created
            List<Download> downloads = downloadManager.getAllDownloads();
            assertTrue(downloads.size() > 0);

            Download createdDownload = downloads.get(0);
            assertEquals(Download.Type.YOUTUBE, createdDownload.getType());
        }

        @Test
        @DisplayName("Should handle magnet links correctly")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testMagnetLinkWorkflow() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setAutoDownloadDetectedUrls(true)
                    .setFilterTorrentUrls(true);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String magnetLink = "magnet:?xt=urn:btih:1234567890abcdef1234567890abcdef12345678&dn=test-file";

            // When
            setSystemClipboard(magnetLink);

            // Then
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            // Verify magnet download was created (would be handled as torrent)
            List<Download> downloads = downloadManager.getAllDownloads();
            assertTrue(downloads.size() > 0);

            Download createdDownload = downloads.get(0);
            assertTrue(createdDownload.getUri().toString().startsWith("magnet:"));
        }
    }

    @Nested
    @DisplayName("Settings Impact Tests")
    class SettingsImpactTest {

        @Test
        @DisplayName("Should respect URL filtering settings")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testUrlFilteringSettings() throws Exception {
            // Given - disable video URL filtering
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setFilterVideoUrls(false) // Disable video URL filtering
                    .setAutoDownloadDetectedUrls(true);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String youtubeUrl = "https://www.youtube.com/watch?v=test123";

            // When
            setSystemClipboard(youtubeUrl);

            // Then - should detect URLs but not create downloads (filtered out)
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            // No downloads should be created since video filtering is disabled
            List<Download> downloads = downloadManager.getAllDownloads();
            assertEquals(0, downloads.size());
        }

        @Test
        @DisplayName("Should respect max URLs per clipboard setting")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testMaxUrlsPerClipboardSetting() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setMaxUrlsPerClipboard(2)
                    .setAutoDownloadDetectedUrls(true);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String multipleUrls = "https://example1.com/file.zip\n"
                    + "https://example2.com/file.zip\n"
                    + "https://example3.com/file.zip\n"
                    + "https://example4.com/file.zip";

            // When
            setSystemClipboard(multipleUrls);

            // Then - only first 2 URLs should be processed
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(500))
                    .until(() -> downloadManager.getAllDownloads().size() >= 2);

            List<Download> downloads = downloadManager.getAllDownloads();
            assertEquals(2, downloads.size(), "Should create only 2 downloads due to max URLs limit");
        }

        @ParameterizedTest
        @ValueSource(longs = {100, 500, 1000, 2000})
        @DisplayName("Should respect monitoring interval setting")
        @Timeout(value = 20, unit = TimeUnit.SECONDS)
        void testMonitoringIntervalSetting(long intervalMs) throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setMonitoringIntervalMs(intervalMs);
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            String testUrl = "https://example.com/test-interval-" + intervalMs + ".zip";

            long startTime = System.currentTimeMillis();

            // When
            setSystemClipboard(testUrl);

            // Then - detection should happen within reasonable time relative to interval
            Awaitility.await()
                    .atMost(Duration.ofMillis(intervalMs * 10)) // Allow up to 10 intervals
                    .pollInterval(Duration.ofMillis(50))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            long detectionTime = System.currentTimeMillis() - startTime;

            // Detection should happen within a reasonable multiple of the interval
            assertTrue(detectionTime >= intervalMs / 2,
                    "Detection should not happen too quickly relative to interval");
            assertTrue(detectionTime <= intervalMs * 5,
                    "Detection should not take too long relative to interval");
        }
    }

    @Nested
    @DisplayName("Manual Import Tests")
    class ManualImportTest {

        @Test
        @DisplayName("Should import URLs manually from current clipboard")
        @Timeout(value = 10, unit = TimeUnit.SECONDS)
        void testManualImport() throws Exception {
            // Given
            String testUrls = "https://example.com/manual1.zip\nhttps://test.org/manual2.exe";
            setSystemClipboard(testUrls);

            // Don't start automatic monitoring
            assertFalse(clipboardService.isServiceEnabled());

            // When - manually import from clipboard
            List<Download> downloads = clipboardService.importFromClipboard().get(5, TimeUnit.SECONDS);

            // Then
            assertEquals(2, downloads.size());
            assertTrue(downloads.get(0).getUri().toString().contains("example.com")
                    || downloads.get(0).getUri().toString().contains("test.org"));
            assertTrue(downloads.get(1).getUri().toString().contains("example.com")
                    || downloads.get(1).getUri().toString().contains("test.org"));
        }

        @Test
        @DisplayName("Should handle manual import with empty clipboard")
        @Timeout(value = 5, unit = TimeUnit.SECONDS)
        void testManualImportEmptyClipboard() throws Exception {
            // Given
            setSystemClipboard(""); // Empty clipboard

            // When
            List<Download> downloads = clipboardService.importFromClipboard().get(3, TimeUnit.SECONDS);

            // Then
            assertTrue(downloads.isEmpty());
        }

        @Test
        @DisplayName("Should handle manual import with no URLs")
        @Timeout(value = 5, unit = TimeUnit.SECONDS)
        void testManualImportNoUrls() throws Exception {
            // Given
            setSystemClipboard("This text contains no downloadable URLs");

            // When
            List<Download> downloads = clipboardService.importFromClipboard().get(3, TimeUnit.SECONDS);

            // Then
            assertTrue(downloads.isEmpty());
        }
    }

    @Nested
    @DisplayName("Performance and Stress Tests")
    class PerformanceTest {

        @Test
        @DisplayName("Should handle rapid clipboard changes")
        @Timeout(value = 30, unit = TimeUnit.SECONDS)
        void testRapidClipboardChanges() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);

            ClipboardSettings settings = clipboardService.getSettings();
            settings.setMonitoringIntervalMs(100); // Very fast monitoring
            clipboardService.updateSettings(settings);

            clipboardService.startService().get(5, TimeUnit.SECONDS);

            // When - rapidly change clipboard content
            for (int i = 0; i < 10; i++) {
                setSystemClipboard("https://example" + i + ".com/file.zip");
                Thread.sleep(150); // Slightly longer than monitoring interval
            }

            // Then - should detect multiple changes
            Awaitility.await()
                    .atMost(Duration.ofSeconds(15))
                    .pollInterval(Duration.ofMillis(100))
                    .until(() -> listener.urlsDetectedCount.get() >= 5);

            assertTrue(listener.urlsDetectedCount.get() >= 5,
                    "Should detect multiple rapid clipboard changes");
        }

        @Test
        @DisplayName("Should handle large clipboard content efficiently")
        @Timeout(value = 15, unit = TimeUnit.SECONDS)
        void testLargeClipboardContent() throws Exception {
            // Given
            TestClipboardServiceListener listener = new TestClipboardServiceListener();
            clipboardService.addServiceListener(listener);
            clipboardService.startService().get(5, TimeUnit.SECONDS);

            // Create large text with embedded URLs
            StringBuilder largeContent = new StringBuilder();
            for (int i = 0; i < 1000; i++) {
                largeContent.append("This is line ").append(i)
                        .append(" with some text content that makes it longer. ");
            }
            largeContent.append("Download: https://example.com/large-content-test.zip");

            long startTime = System.currentTimeMillis();

            // When
            setSystemClipboard(largeContent.toString());

            // Then - should detect URL efficiently
            Awaitility.await()
                    .atMost(Duration.ofSeconds(10))
                    .pollInterval(Duration.ofMillis(200))
                    .until(() -> listener.urlsDetectedCount.get() > 0);

            long processingTime = System.currentTimeMillis() - startTime;

            assertTrue(processingTime < 5000,
                    "Should process large clipboard content within 5 seconds");
            assertEquals(1, listener.lastDetectedUrls.get().size());
        }
    }

    /**
     * Helper method to set system clipboard content. This simulates a user
     * copying content to the clipboard.
     */
    private void setSystemClipboard(String content) throws Exception {
        try {
            Clipboard clipboard = Toolkit.getDefaultToolkit().getSystemClipboard();
            StringSelection selection = new StringSelection(content);
            clipboard.setContents(selection, null);

            // Small delay to ensure clipboard is updated
            Thread.sleep(100);
        } catch (Exception e) {
            // If we can't access system clipboard (e.g., in headless environment),
            // skip the test or use mock
            org.junit.jupiter.api.Assumptions.assumeTrue(false,
                    "System clipboard not available: " + e.getMessage());
        }
    }

    /**
     * Test implementation of ClipboardServiceListener for E2E testing.
     */
    private static class TestClipboardServiceListener implements ClipboardServiceListener {

        final AtomicInteger startedCount = new AtomicInteger(0);
        final AtomicInteger stoppedCount = new AtomicInteger(0);
        final AtomicInteger urlsDetectedCount = new AtomicInteger(0);
        final AtomicInteger confirmationRequiredCount = new AtomicInteger(0);
        final AtomicInteger errorCount = new AtomicInteger(0);

        final AtomicReference<List<URI>> lastDetectedUrls = new AtomicReference<>();
        final AtomicReference<String> lastClipboardContent = new AtomicReference<>();
        final AtomicReference<Exception> lastError = new AtomicReference<>();

        @Override
        public void onServiceStarted() {
            startedCount.incrementAndGet();
        }

        @Override
        public void onServiceStopped() {
            stoppedCount.incrementAndGet();
        }

        @Override
        public void onUrlsDetected(List<URI> urls, String clipboardContent) {
            urlsDetectedCount.incrementAndGet();
            lastDetectedUrls.set(urls);
            lastClipboardContent.set(clipboardContent);
        }

        @Override
        public void onConfirmationRequired(List<URI> urls, String clipboardContent) {
            confirmationRequiredCount.incrementAndGet();
            lastDetectedUrls.set(urls);
            lastClipboardContent.set(clipboardContent);
        }

        @Override
        public void onClipboardError(Exception error) {
            errorCount.incrementAndGet();
            lastError.set(error);
        }
    }
}
