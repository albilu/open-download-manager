# === Network settings (with stream isolation) ===

SocksPort 127.0.0.1:9050 IsolateClientAddr IsolateSOCKSAuth IsolateClientProtocol IsolateDestAddr IsolateDestPort

# Additional app‑specific ports (optional):

# SocksPort 127.0.0.1:9060 ...

ControlPort 9051

DNSPort 9053
AutomapHostsOnResolve 1
AutomapHostsSuffixes .exit,.onion

# Prevent peers from leaking DNS via unsafe socks

SafeSocks 1
TestSocks 1
NoExec 1

# === Leak detection and plaintext blocking ===

WarnPlaintextPorts 23,109,110,143,80

# Or use RejectPlaintextPorts instead for absolute blocking

# === Circuit and guard rotation ===

UseEntryGuards 1
EnforceDistinctSubnets 1
NumEntryGuards 4
NewCircuitPeriod 300 # e.g. every 5 minutes (faster than default 900 s)
MaxCircuitDirtiness 600 # rotate after 10 min
StrictNodes 1

# === Privacy / sandboxing ===

ClientOnly 1
ClientRejectInternalAddresses 1
AllowNonRFC953Hostnames 0
Sandbox 1
AvoidDiskWrites 1

# === Logging ===

Log notice stdout
# Log notice file /var/log/odm/tor/tor.log

# === Data directory and runtime ===

# DataDirectory set programmatically
