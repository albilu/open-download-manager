<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.odm</id>
  <name>oDM</name>
  <summary>Full-featured download manager for Linux</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Open Download Manager (ODM) is a comprehensive download manager designed
      for Linux. It combines multi-connection downloads, BitTorrent, video
      downloads and website mirroring in one native GTK4 desktop application.
    </p>
    <p>Key features:</p>
    <ul>
      <li>Multi-connection HTTP/HTTPS/FTP downloads via aria2</li>
      <li>BitTorrent, magnet and Metalink support</li>
      <li>Video and media downloads via yt-dlp</li>
      <li>Website mirroring via HTTrack</li>
      <li>Pause, resume, queue limits and scheduling</li>
      <li>Clipboard and torrent-folder monitoring</li>
      <li>Proxy rotation, proxychains and Tor routing</li>
      <li>After-completion actions and persistent history</li>
    </ul>
  </description>
  <launchable type="desktop-id">org.odm.desktop</launchable>
  <icon type="stock">open-download-manager</icon>
  <categories>
    <category>Network</category>
    <category>FileTransfer</category>
  </categories>
