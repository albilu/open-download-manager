# Maintainer: ODM Development Team <dev@odm-project.org>
pkgname=open-download-manager
pkgver=__VERSION__
pkgrel=1
pkgdesc="Full-featured download manager for Linux based on aria2, yt-dlp and httrack (bundled Java runtime)"
arch=('x86_64')
url="https://github.com/albilu/odm"
license=('GPL-3.0-or-later')
depends=(
    'gtk4>=4.10'
    'aria2>=1.34.0'
    'curl>=7.80.0'
    'yt-dlp>=2024.01.01'
    'httrack>=3.49.0'
)
optdepends=(
    'proxychains-ng: SOCKS proxy chains'
    'tor: anonymous downloads'
    'ffmpeg: video processing'
)
source=("opt-open-download-manager.tar")
noextract=()

package() {
    cp -a "${srcdir}/opt" "${pkgdir}/"
    cp -a "${srcdir}/usr" "${pkgdir}/"
    chmod 755 "${pkgdir}/usr/bin/open-download-manager"
    install -Dm644 "${srcdir}/usr/share/licenses/open-download-manager/LICENSE" \
        "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}

# The source tarball is assembled by packaging/build-packages.sh from the
# staged install tree (bundled jlink runtime + shaded jar).
