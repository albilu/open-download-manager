#!/bin/bash
# AppRun entry point for the oDM AppImage. The AppDir reuses the packaging
# stage tree, so the payload lives under opt/open-download-manager.
set -e

APPDIR="${APPDIR:-$(dirname "$(readlink -f "$0")")}"

# Java environment (bundled jlink runtime staged under /opt)
export JAVA_HOME="$APPDIR/opt/open-download-manager/runtime"
export PATH="$JAVA_HOME/bin:$APPDIR/usr/bin:$PATH"

# GTK/GLib environment: prefer the bundled GTK4 stack over the host one
export LD_LIBRARY_PATH="$APPDIR/usr/lib:$APPDIR/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GI_TYPELIB_PATH="$APPDIR/usr/lib/x86_64-linux-gnu/girepository-1.0:${GI_TYPELIB_PATH:+:$GI_TYPELIB_PATH}"

# gdk-pixbuf loader paths are absolute, so regenerate the cache for the
# current mount location on every launch (fast; avoids stale paths).
GDK_PIXBUF_ROOT="$APPDIR/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0"
GDK_PIXBUF_DIR="$GDK_PIXBUF_ROOT/2.10.0"
if [ -x "$GDK_PIXBUF_ROOT/gdk-pixbuf-query-loaders" ] && [ -d "$GDK_PIXBUF_DIR/loaders" ]; then
    CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/open-download-manager-appimage"
    if mkdir -p "$CACHE_DIR" 2>/dev/null && \
            GDK_PIXBUF_MODULEDIR="$GDK_PIXBUF_DIR/loaders" \
            "$GDK_PIXBUF_ROOT/gdk-pixbuf-query-loaders" > "$CACHE_DIR/loaders.cache" 2>/dev/null; then
        export GDK_PIXBUF_MODULEDIR="$GDK_PIXBUF_DIR/loaders"
        export GDK_PIXBUF_MODULE_FILE="$CACHE_DIR/loaders.cache"
    fi
fi

# XDG environment so the bundled desktop/icon/metainfo data is visible
export XDG_DATA_DIRS="$APPDIR/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Validation: fail fast on a corrupt/incomplete AppImage
APP_JAR="$APPDIR/opt/open-download-manager/odm.jar"
if [ ! -x "$JAVA_HOME/bin/java" ]; then
    echo "[ERROR] Java runtime not found at: $JAVA_HOME" >&2
    exit 1
fi
JAVA_VERSION=$("$JAVA_HOME/bin/java" -version 2>&1 | sed -nE 's/.*version "([0-9]+).*/\1/p' | head -n 1)
if [[ ! "$JAVA_VERSION" =~ ^[0-9]+$ ]] || (( JAVA_VERSION < 25 )); then
    echo "[ERROR] Java version $JAVA_VERSION is too old. Java 25 or newer is required." >&2
    exit 1
fi
if [ ! -f "$APP_JAR" ]; then
    echo "[ERROR] Application JAR not found at: $APP_JAR" >&2
    exit 1
fi

JVM_OPTS=(
    "--enable-native-access=ALL-UNNAMED"
)
if [ -n "$ODM_JVM_OPTS" ]; then
    JVM_OPTS=($ODM_JVM_OPTS)
fi

# Wayland preferred, X11 fallback
if [ -n "$WAYLAND_DISPLAY" ]; then
    export GDK_BACKEND="wayland,x11"
elif [ -n "$DISPLAY" ]; then
    export GDK_BACKEND="x11"
fi

case "$1" in
    --help|-h)
        echo "Open Download Manager (AppImage)"
        echo "Usage: $(basename "$0") [OPTIONS] [URL...]"
        exit 0
        ;;
    --version|-v)
        echo "Open Download Manager (AppImage)"
        "$JAVA_HOME/bin/java" -version 2>&1 | head -n 1
        exit 0
        ;;
esac

exec "$JAVA_HOME/bin/java" "${JVM_OPTS[@]}" -jar "$APP_JAR" "$@"
