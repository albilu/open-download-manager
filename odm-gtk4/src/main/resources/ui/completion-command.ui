<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkWindow" id="completion_command_dialog">
    <property name="title">Custom completion command</property>
    <property name="default-width">520</property>
    <child>
      <object class="GtkBox" id="completion_command_content">
        <property name="orientation">vertical</property>
        <property name="spacing">10</property>
        <property name="margin-start">12</property>
        <property name="margin-end">12</property>
        <property name="margin-top">12</property>
        <property name="margin-bottom">12</property>
        <child>
          <object class="GtkLabel" id="completion_command_help_label">
            <property name="label">Command to run on completion. Variables: {file_path} {filename} {dir} {url} {id} {gid}</property>
            <property name="xalign">0</property>
            <property name="wrap">true</property>
          </object>
        </child>
        <child>
          <object class="GtkEntry" id="completion_command_entry">
            <property name="placeholder-text">mv {file_path} /tmp</property>
          </object>
        </child>
        <child>
          <object class="GtkBox" id="completion_command_actions">
            <property name="orientation">horizontal</property>
            <property name="spacing">6</property>
            <property name="halign">end</property>
            <child><object class="GtkButton" id="completion_command_cancel_button"><property name="label">Cancel</property></object></child>
            <child><object class="GtkButton" id="completion_command_save_button"><property name="label">Save</property><property name="css-classes">['suggested-action']</property></object></child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
