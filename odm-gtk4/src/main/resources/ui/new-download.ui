<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkAdjustment" id="download_speed_adjustment">
    <property name="lower">0</property>
    <property name="upper">1048576</property>
    <property name="value">0</property>
    <property name="step-increment">100</property>
    <property name="page-increment">1024</property>
  </object>
  <object class="GtkAdjustment" id="upload_speed_adjustment">
    <property name="lower">0</property>
    <property name="upper">1048576</property>
    <property name="value">0</property>
    <property name="step-increment">100</property>
    <property name="page-increment">1024</property>
  </object>
  <object class="GtkAdjustment" id="max_connections_adjustment">
    <property name="lower">1</property>
    <property name="upper">16</property>
    <property name="value">8</property>
    <property name="step-increment">1</property>
    <property name="page-increment">4</property>
  </object>
  <object class="GtkAdjustment" id="retry_limit_adjustment">
    <property name="lower">0</property>
    <property name="upper">50</property>
    <property name="value">5</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="retry_after_adjustment">
    <property name="lower">0</property>
    <property name="upper">600</property>
    <property name="value">0</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="proxy_port_adjustment">
    <property name="lower">0</property>
    <property name="upper">65535</property>
    <property name="value">8080</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkListStore" id="files_liststore">
    <columns>
      <column type="gboolean"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>

  <object class="GtkWindow" id="new_download_dialog">
    <property name="title">New Download</property>
    <property name="modal">true</property>
    <property name="default-width">640</property>
    <property name="default-height">520</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>

        <child>
          <object class="GtkBox" id="bottom_box">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkNotebook" id="options_notebook">
                <property name="vexpand">true</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>

                <!-- DOWNLOAD TAB -->
                <child>
                  <object class="GtkGrid">
                    <property name="row-spacing">10</property>
                    <property name="column-spacing">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">URL:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">0</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="url_entry">
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">URL/Magnet link</property>
                        <layout><property name="row">0</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">File:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">1</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="torrent_file_chooser">
                        <property name="label">Torrent/Metalink file…</property>
                        <property name="hexpand">true</property>
                        <layout><property name="row">1</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Save to:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">2</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <layout><property name="row">2</property><property name="column">1</property></layout>
                        <child>
                          <object class="GtkMenuButton" id="save_folder_chooser">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="disk_space_label">
                            <property name="label"></property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Filename:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">3</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="filename_entry">
                        <property name="hexpand">true</property>
                        <layout><property name="row">3</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Checksum:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">4</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <layout><property name="row">4</property><property name="column">1</property></layout>
                        <child>
                          <object class="GtkLabel" id="checksum_label">
                            <property name="label">—</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <property name="ellipsize">end</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="verify_checksum_check">
                            <property name="label">Verify at completion</property>
                            <property name="visible">false</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel"><property name="label">Download</property></object>
                </child>

                <!-- FILES TAB -->
                <child>
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="GtkTreeView" id="files_treeview">
                        <property name="model">files_liststore</property>
                        <child>
                          <object class="GtkTreeViewColumn">
                            <child><object class="GtkCellRendererToggle" id="selected_renderer"/><attributes><attribute name="active">0</attribute></attributes></child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn">
                            <property name="title">Filename</property>
                            <child><object class="GtkCellRendererText" id="file_name"/><attributes><attribute name="text">1</attribute></attributes></child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn">
                            <property name="title">Size</property>
                            <child><object class="GtkCellRendererText" id="file_size"/><attributes><attribute name="text">2</attribute></attributes></child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn">
                            <property name="title">Priority</property>
                            <child><object class="GtkCellRendererText" id="file_priority"/><attributes><attribute name="text">3</attribute></attributes></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel"><property name="label">Files</property></object>
                </child>

                <!-- OPTIONS TAB -->
                <child>
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="GtkBox" id="settings_box">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="margin-start">12</property>
                        <property name="margin-end">12</property>
                        <property name="margin-top">12</property>
                        <property name="margin-bottom">12</property>

                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Download Settings&lt;/b&gt;</property>
                            <property name="use-markup">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid" id="settings_grid">
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">10</property>
                            <child><object class="GtkLabel"><property name="label">Max Connections:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_connections_spin"><property name="adjustment">max_connections_adjustment</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry Limit:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_limit_spin"><property name="adjustment">retry_limit_adjustment</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Download Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_download_speed_spin"><property name="adjustment">download_speed_adjustment</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Upload Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_upload_speed_spin"><property name="adjustment">upload_speed_adjustment</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry After(s):</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_after"><property name="adjustment">retry_after_adjustment</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;HTTP Connection&lt;/b&gt;</property>
                            <property name="use-markup">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid">
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">10</property>
                            <child><object class="GtkLabel"><property name="label">Referer:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="referrer"><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Cookie:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="cookie"><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">User Agent:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="user_agent"><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Proxy Settings&lt;/b&gt;</property>
                            <property name="use-markup">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid">
                            <property name="row-spacing">6</property>
                            <property name="column-spacing">10</property>
                            <child><object class="GtkLabel"><property name="label">Proxy Type:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkDropDown" id="proxy_type_combo"><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_host_label"><property name="label">Proxy Host:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_host_entry"><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_port_label"><property name="label">Proxy Port:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="proxy_port_spin"><property name="adjustment">proxy_port_adjustment</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_username_label"><property name="label">Username:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_username_entry"><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_password_label"><property name="label">Password:</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_password_entry"><property name="visibility">false</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Tor Settings&lt;/b&gt;</property>
                            <property name="use-markup">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">horizontal</property>
                            <property name="spacing">10</property>
                            <child><object class="GtkLabel"><property name="label">Enable Tor:</property><property name="xalign">0</property></object></child>
                            <child><object class="GtkSwitch" id="tor_switch"/></child>
                          </object>
                        </child>

                        <child>
                          <object class="GtkLabel">
                            <property name="label">&lt;b&gt;Options&lt;/b&gt;</property>
                            <property name="use-markup">true</property>
                            <property name="xalign">0</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkBox">
                            <property name="orientation">vertical</property>
                            <property name="spacing">6</property>
                            <child><object class="GtkCheckButton" id="start_automatically_check"><property name="label">Start automatically</property><property name="active">true</property></object></child>
                            <child><object class="GtkCheckButton" id="move_torrent_check"><property name="label">Move .torrent/.meta4 to draft</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel"><property name="label">Options</property></object>
                </child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="orientation">horizontal</property>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkSpinner" id="new_download_spinner"/>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="new_download_cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="new_download_start_button">
                <property name="label">Start Download</property>
                <property name="css-classes">['suggested-action']</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
