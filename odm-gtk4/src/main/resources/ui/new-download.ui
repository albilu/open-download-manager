<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkTreeStore" id="files_liststore">
    <columns>
      <column type="gboolean"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gint"/><column type="gchararray"/><column type="gint"/>
      <column type="gchararray"/><column type="gint64"/><column type="gdouble"/>
      <column type="gchararray"/><column type="gboolean"/><column type="gboolean"/>
      <column type="gint"/><column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="file_priority_store">
    <columns><column type="gchararray"/></columns>
  </object>

  <object class="GtkWindow" id="new_download_dialog">
    <property name="title">New Download</property>
    <property name="modal">true</property>
    <property name="default-width">640</property>
    <property name="default-height">520</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>

        <child>
          <object class="GtkBox" id="bottom_box">
            <property name="orientation">vertical</property>
            <property name="vexpand">true</property>
            <child>
              <object class="GtkNotebook" id="options_notebook">
                <property name="vexpand">true</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>

                <!-- DOWNLOAD TAB -->
                <child>
                  <object class="GtkGrid" id="download_page">
                    <property name="row-spacing">10</property>
                    <property name="column-spacing">10</property>
                    <property name="margin-start">12</property>
                    <property name="margin-end">12</property>
                    <property name="margin-top">12</property>
                    <property name="margin-bottom">12</property>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">URL:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">0</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="url_entry">
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">URL/Magnet link</property>
                        <layout><property name="row">0</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">File:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">1</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="torrent_file_chooser">
                        <property name="label">Torrent/Metalink file…</property>
                        <property name="hexpand">true</property>
                        <layout><property name="row">1</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Save to:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">2</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property>
                        <property name="spacing">4</property>
                        <layout><property name="row">2</property><property name="column">1</property></layout>
                        <child>
                          <object class="GtkMenuButton" id="save_folder_chooser">
                            <property name="hexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="disk_space_label">
                            <property name="label"></property>
                            <property name="halign">end</property>
                            <property name="xalign">1</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Filename:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">3</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkEntry" id="filename_entry">
                        <property name="hexpand">true</property>
                        <layout><property name="row">3</property><property name="column">1</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel">
                        <property name="label">Checksum:</property>
                        <property name="xalign">0</property>
                        <layout><property name="row">4</property><property name="column">0</property></layout>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <layout><property name="row">4</property><property name="column">1</property></layout>
                        <child>
                          <object class="GtkLabel" id="checksum_label">
                            <property name="label">—</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <property name="ellipsize">end</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="verify_checksum_check">
                            <property name="label">Verify at completion</property>
                            <property name="visible">false</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel"><property name="label">Download</property></object>
                </child>

                <!-- FILES TAB -->
                <child>
                  <object class="GtkBox" id="files_page">
                    <property name="orientation">vertical</property>
                    <property name="spacing">6</property>
                    <property name="margin-start">8</property>
                    <property name="margin-end">8</property>
                    <property name="margin-top">8</property>
                    <property name="margin-bottom">8</property>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <child>
                          <object class="GtkLabel" id="files_status_label">
                            <property name="label">Enter a torrent, magnet, or Metalink source to inspect its files.</property>
                            <property name="hexpand">true</property>
                            <property name="xalign">0</property>
                            <property name="wrap">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkCheckButton" id="select_all_files_check">
                            <property name="label">Select all</property>
                            <property name="active">true</property>
                            <property name="sensitive">false</property>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkScrolledWindow">
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkTreeView" id="files_treeview">
                            <property name="model">files_liststore</property>
                            <property name="enable-tree-lines">true</property>
                            <child>
                              <object class="GtkTreeViewColumn" id="new_files_selected_column">
                                <property name="sort-column-id">0</property>
                                <child><object class="GtkCellRendererToggle" id="selected_renderer"><property name="activatable">true</property></object><attributes><attribute name="active">0</attribute><attribute name="inconsistent">11</attribute></attributes></child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="new_files_name_column">
                                <property name="title">Filename</property>
                                <property name="expand">true</property>
                                <property name="resizable">true</property>
                                <property name="min-width">180</property>
                                <property name="max-width">420</property>
                                <property name="sort-column-id">1</property>
                                <child><object class="GtkCellRendererPixbuf" id="new_files_icon_renderer"/><attributes><attribute name="icon-name">13</attribute></attributes></child>
                                <child><object class="GtkCellRendererText" id="file_name"><property name="ellipsize">end</property></object><attributes><attribute name="text">1</attribute></attributes></child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="new_files_size_column">
                                <property name="title">Size</property>
                                <property name="sort-column-id">7</property>
                                <child><object class="GtkCellRendererText" id="file_size"/><attributes><attribute name="text">2</attribute></attributes></child>
                              </object>
                            </child>
                            <child>
                              <object class="GtkTreeViewColumn" id="new_files_priority_column">
                                <property name="title">Priority</property>
                                <property name="sort-column-id">12</property>
                                <child>
                                  <object class="GtkCellRendererCombo" id="file_priority">
                                    <property name="model">file_priority_store</property>
                                    <property name="text-column">0</property>
                                    <property name="has-entry">false</property>
                                    <property name="editable">true</property>
                                  </object>
                                  <attributes><attribute name="text">4</attribute></attributes>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel"><property name="label">Files</property></object>
                </child>

                <!-- OPTIONS TAB -->
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="hscrollbar-policy">never</property>
                    <child>
                      <object class="GtkBox" id="new_download_options_content">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkBox" id="new_download_network_options_host">
                            <property name="orientation">vertical</property>
                            <property name="vexpand">true</property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkGrid" id="sftp_host_key_grid">
                            <property name="visible">false</property>
                            <property name="column-homogeneous">true</property>
                            <property name="column-spacing">12</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-bottom">14</property>
                            <child>
                              <object class="GtkLabel" id="sftp_host_key_label">
                                <property name="label">SFTP host key digest:</property>
                                <property name="xalign">0</property>
                                <layout><property name="row">0</property><property name="column">0</property></layout>
                              </object>
                            </child>
                            <child>
                              <object class="GtkEntry" id="sftp_host_key_entry">
                                <property name="hexpand">true</property>
                                <property name="placeholder-text">sha-1=&lt;40 hex digits&gt;</property>
                                <layout><property name="row">0</property><property name="column">1</property></layout>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab"><object class="GtkLabel"><property name="label">Options</property></object></child>
              </object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="orientation">horizontal</property>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkBox">
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkSpinner" id="new_download_spinner"/>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="new_download_cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="new_download_start_button">
                <property name="label">Start Download</property>
                <property name="css-classes">['suggested-action']</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
