<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkAdjustment" id="num_start_adjustment">
    <property name="lower">0</property><property name="upper">999999</property><property name="value">1</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="num_vers_adjustment">
    <property name="lower">0</property><property name="upper">999999</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="num_count_adjustment">
    <property name="lower">1</property><property name="upper">1000</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="char_vers_adjustment">
    <property name="lower">0</property><property name="upper">999999</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="none_start_adjustment">
    <property name="lower">0</property><property name="upper">999999</property><property name="value">1</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="none_vers_adjustment">
    <property name="lower">0</property><property name="upper">999999</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="none_count_adjustment">
    <property name="lower">1</property><property name="upper">999999</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="download_speed_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">0</property><property name="step-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="upload_speed_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">0</property><property name="step-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="max_connections_adjustment">
    <property name="lower">1</property><property name="upper">64</property><property name="value">8</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="retry_limit_adjustment">
    <property name="lower">0</property><property name="upper">50</property><property name="value">5</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="retry_after_adjustment">
    <property name="lower">0</property><property name="upper">600</property><property name="value">0</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="proxy_port_adjustment">
    <property name="lower">0</property><property name="upper">65535</property><property name="value">8080</property><property name="step-increment">1</property>
  </object>

  <object class="GtkListStore" id="preview_liststore">
    <columns><column type="gchararray"/></columns>
  </object>

  <object class="GtkWindow" id="import_sequence_dialog">
    <property name="title">Import URL Sequence</property>
    <property name="default-width">720</property>
    <property name="default-height">560</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>

        <child>
          <object class="GtkNotebook" id="main_notebook">
            <property name="vexpand">true</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>

            <!-- SEQUENCE TAB -->
            <child>
              <object class="GtkBox" id="sequence_page">
                <property name="orientation">vertical</property>
                <property name="spacing">10</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property><property name="spacing">8</property>
                    <child><object class="GtkLabel"><property name="label">URL:</property><property name="xalign">0</property></object></child>
                    <child><object class="GtkEntry" id="uri_entry"><property name="hexpand">true</property><property name="placeholder-text">https://example.com/file-{}.zip</property></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkGrid">
                    <property name="row-spacing">8</property><property name="column-spacing">8</property>
                    <child><object class="GtkDropDown" id="num_combo"><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="num_start_spin"><property name="adjustment">num_start_adjustment</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Vers :</property><layout><property name="row">0</property><property name="column">2</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="num_vers_spin"><property name="adjustment">num_vers_adjustment</property><layout><property name="row">0</property><property name="column">3</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Nb :</property><layout><property name="row">0</property><property name="column">4</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="num_count_spin"><property name="adjustment">num_count_adjustment</property><layout><property name="row">0</property><property name="column">5</property></layout></object></child>
                    <child><object class="GtkDropDown" id="char_combo"><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkEntry" id="char_entry"><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Vers :</property><layout><property name="row">1</property><property name="column">2</property></layout></object></child>
                    <child><object class="GtkEntry" id="char_vers_entry"><layout><property name="row">1</property><property name="column">3</property></layout></object></child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">true</property>
                    <child>
                      <object class="GtkTreeView" id="preview_treeview">
                        <property name="model">preview_liststore</property>
                        <child>
                          <object class="GtkTreeViewColumn" id="url_column">
                            <property name="title">Preview</property>
                            <child><object class="GtkCellRendererText"/><attributes><attribute name="text">0</attribute></attributes></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property><property name="spacing">8</property>
                    <child><object class="GtkLabel"><property name="label">Save to:</property></object></child>
                    <child>
                      <object class="GtkBox">
                        <property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                        <child><object class="GtkMenuButton" id="destination_folder"><property name="hexpand">true</property></object></child>
                        <child><object class="GtkLabel" id="disk_space_label"><property name="label"></property><property name="halign">end</property><property name="xalign">1</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab"><object class="GtkLabel"><property name="label">Séquence</property></object></child>

            <!-- OPTIONS TAB -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="settings_box">
<property name="orientation">vertical</property>
<child>
<object class="GtkGrid" id="options_columns_grid">
                    <property name="hexpand">true</property><property name="vexpand">true</property>
                    <property name="column-homogeneous">true</property><property name="column-spacing">20</property>
                    <property name="margin-start">12</property><property name="margin-end">12</property>
                    <property name="margin-top">14</property><property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkBox" id="options_left_column">
                        <property name="orientation">vertical</property><property name="spacing">10</property><property name="hexpand">true</property>
                        <layout><property name="row">0</property><property name="column">0</property></layout>
                        <child><object class="GtkLabel" id="download_settings_heading"><property name="label">&lt;b&gt;Download Settings&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property></object></child>
                        <child>
                          <object class="GtkGrid" id="settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Max Connections:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_connections_spin"><property name="adjustment">max_connections_adjustment</property><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry Limit:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_limit_spin"><property name="adjustment">retry_limit_adjustment</property><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry After (s):</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_after"><property name="adjustment">retry_after_adjustment</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Download Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_download_speed_spin"><property name="adjustment">download_speed_adjustment</property><property name="hexpand">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Upload Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_upload_speed_spin"><property name="adjustment">upload_speed_adjustment</property><property name="hexpand">true</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                        <child><object class="GtkLabel" id="http_connection_heading"><property name="label">&lt;b&gt;HTTP Connection&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">4</property></object></child>
                        <child>
                          <object class="GtkGrid" id="http_connection_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Referer:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="referrer_entry"><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Cookie:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="cookie_entry"><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">User Agent:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="user_agent_entry"><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="options_right_column">
                        <property name="orientation">vertical</property><property name="spacing">10</property><property name="hexpand">true</property>
                        <layout><property name="row">0</property><property name="column">1</property></layout>
                        <child><object class="GtkLabel" id="proxy_settings_heading"><property name="label">&lt;b&gt;Proxy Settings&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property></object></child>
                        <child>
                          <object class="GtkGrid" id="proxy_settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Proxy Type:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkDropDown" id="proxy_type_combo"><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_host_label"><property name="label">Proxy Host:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_host_entry"><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_port_label"><property name="label">Proxy Port:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="proxy_port_spin"><property name="adjustment">proxy_port_adjustment</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_username_label"><property name="label">Username:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_username_entry"><property name="hexpand">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_password_label"><property name="label">Password:</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_password_entry"><property name="visibility">false</property><property name="hexpand">true</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                        <child><object class="GtkLabel" id="tor_settings_heading"><property name="label">&lt;b&gt;Tor Settings&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">4</property></object></child>
                        <child>
                          <object class="GtkGrid" id="tor_settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Enable Tor:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSwitch" id="tor_switch"><property name="halign">start</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
</child>
</object>
                </child>
              </object>
            </child>
            <child type="tab"><object class="GtkLabel"><property name="label">Options</property></object></child>
          </object>
        </child>

        <child><object class="GtkSeparator"><property name="orientation">horizontal</property></object></child>

        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">12</property>
            <property name="halign">end</property>
            <child>
              <object class="GtkSpinner" id="import_sequence_spinner">
                <property name="valign">center</property>
              </object>
            </child>
            <child><object class="GtkButton" id="cancel_button"><property name="label">Cancel</property></object></child>
            <child><object class="GtkButton" id="validate_button"><property name="label">Start Download</property><property name="css-classes">['suggested-action']</property></object></child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
