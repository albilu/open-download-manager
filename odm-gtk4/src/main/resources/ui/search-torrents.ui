<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkListStore" id="torrent_results_store">
    <columns>
      <column type="gint"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gint64"/><column type="gint64"/><column type="gchararray"/>
      <column type="gint64"/><column type="gint64"/><column type="gchararray"/>
      <column type="gboolean"/><column type="gboolean"/>
    </columns>
  </object>
  <object class="GtkTreeStore" id="torrent_files_store">
    <columns>
      <column type="gboolean"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gint"/><column type="gchararray"/><column type="gint"/>
      <column type="gchararray"/><column type="gint64"/><column type="gdouble"/>
      <column type="gchararray"/><column type="gboolean"/><column type="gboolean"/>
      <column type="gint"/><column type="gchararray"/>
      <column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkWindow" id="search_torrents_dialog">
    <property name="title">Search Torrents</property>
    <property name="default-width">940</property><property name="default-height">650</property>
    <child><object class="GtkBox">
      <property name="orientation">vertical</property><property name="spacing">10</property>
      <property name="margin-start">12</property><property name="margin-end">12</property>
      <property name="margin-top">12</property><property name="margin-bottom">12</property>
      <child><object class="GtkNotebook" id="torrent_notebook">
        <property name="vexpand">true</property>
        <child><object class="GtkBox" id="torrent_search_page">
          <property name="orientation">vertical</property><property name="spacing">8</property>
          <property name="margin-start">8</property><property name="margin-end">8</property>
          <property name="margin-top">8</property><property name="margin-bottom">8</property>
          <child><object class="GtkBox">
            <property name="spacing">8</property>
            <child><object class="GtkEntry" id="torrent_query_entry"><property name="hexpand">true</property><property name="placeholder-text">Search torrents…</property></object></child>
            <child><object class="GtkDropDown" id="torrent_category_combo"/></child>
            <child><object class="GtkButton" id="torrent_search_button"><property name="label">Search</property></object></child>
          </object></child>
          <child><object class="GtkScrolledWindow">
            <property name="vexpand">true</property>
            <child><object class="GtkTreeView" id="torrent_results_view">
              <property name="model">torrent_results_store</property>
              <child><object class="GtkTreeViewColumn" id="torrent_checked_column">
                <property name="title">Select</property><property name="sort-column-id">9</property>
                <child><object class="GtkCellRendererToggle" id="torrent_result_toggle"><property name="activatable">true</property></object><attributes><attribute name="active">9</attribute><attribute name="sensitive">10</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_name_column">
                <property name="title">Name</property><property name="expand">true</property><property name="resizable">true</property><property name="min-width">220</property><property name="sort-column-id">1</property>
                <child><object class="GtkCellRendererText"><property name="ellipsize">end</property></object><attributes><attribute name="text">1</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_size_column">
                <property name="title">Size</property><property name="sort-column-id">6</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">2</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_seeders_column">
                <property name="title">Seeders</property><property name="sort-column-id">3</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">3</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_leechers_column">
                <property name="title">Leechers</property><property name="sort-column-id">4</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">4</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_published_column">
                <property name="title">Published</property><property name="sort-column-id">7</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">5</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_tracker_column">
                <property name="title">Indexer</property><property name="sort-column-id">8</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">8</attribute></attributes></child>
              </object></child>
            </object></child>
          </object></child>
        </object></child>
        <child type="tab"><object class="GtkLabel"><property name="label">Search</property></object></child>
        <child><object class="GtkBox" id="torrent_files_page">
          <property name="orientation">vertical</property><property name="spacing">8</property>
          <property name="margin-start">8</property><property name="margin-end">8</property>
          <property name="margin-top">8</property><property name="margin-bottom">8</property>
          <child><object class="GtkLabel" id="torrent_files_status"><property name="label">Check torrents in Search to see their files.</property><property name="xalign">0</property><property name="ellipsize">end</property></object></child>
          <child><object class="GtkButton" id="torrent_files_reload"><property name="label">Load files</property><property name="halign">start</property><property name="sensitive">false</property></object></child>
          <child><object class="GtkScrolledWindow"><property name="vexpand">true</property>
            <child><object class="GtkTreeView" id="torrent_files_view"><property name="model">torrent_files_store</property><property name="enable-tree-lines">true</property>
              <child><object class="GtkTreeViewColumn">
                <child><object class="GtkCellRendererToggle" id="torrent_file_toggle"><property name="activatable">true</property></object><attributes><attribute name="active">0</attribute><attribute name="inconsistent">11</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn" id="torrent_file_name_column">
                <property name="title">Filename</property><property name="expand">true</property><property name="sort-column-id">1</property>
                <child><object class="GtkCellRendererPixbuf"/><attributes><attribute name="icon-name">13</attribute></attributes></child>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">1</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn">
                <property name="title">Size</property><property name="sort-column-id">7</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">2</attribute></attributes></child>
              </object></child>
              <child><object class="GtkTreeViewColumn">
                <property name="title">Status</property>
                <child><object class="GtkCellRendererText"/><attributes><attribute name="text">14</attribute></attributes></child>
              </object></child>
            </object></child>
          </object></child>
        </object></child>
        <child type="tab"><object class="GtkLabel"><property name="label">Files</property></object></child>
        <child><object class="GtkScrolledWindow">
          <property name="vexpand">true</property><property name="hscrollbar-policy">never</property>
          <child><object class="GtkBox" id="torrent_options_host"><property name="orientation">vertical</property></object></child>
        </object></child>
        <child type="tab"><object class="GtkLabel"><property name="label">Options</property></object></child>
      </object></child>
      <child><object class="GtkBox"><property name="spacing">8</property>
        <child><object class="GtkLabel"><property name="label">Save to:</property></object></child>
        <child><object class="GtkMenuButton" id="torrent_folder_chooser"><property name="hexpand">true</property></object></child>
      </object></child>
      <child><object class="GtkLabel" id="torrent_status_label"><property name="accessible-role">status</property><property name="xalign">0</property><property name="ellipsize">end</property></object></child>
      <child><object class="GtkBox"><property name="spacing">8</property><property name="halign">end</property>
        <child><object class="GtkSpinner" id="torrent_spinner"/></child>
        <child><object class="GtkButton" id="torrent_close_button"><property name="label">Close</property></object></child>
        <child><object class="GtkButton" id="torrent_download_button"><property name="label">Download</property><property name="sensitive">false</property></object></child>
      </object></child>
    </object></child>
  </object>
</interface>
