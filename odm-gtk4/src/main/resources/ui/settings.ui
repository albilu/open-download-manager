                        <child><object class="GtkLabel"><property name="label">Maximum URLs per import:</property><property name="xalign">0</property><property name="tooltip-text">Applies to URL lists, generated sequences, and links extracted from HTML.</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                        <child><object class="GtkSpinButton" id="max_import_urls_spin"><property name="adjustment">max_import_urls_adjustment</property><property name="hexpand">true</property><property name="tooltip-text">Allowed range: 1 to 10,000 URLs per import.</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
