                    <child><object class="GtkLabel" id="history_cleanup_heading"><property name="label">&lt;b&gt;Download History&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">6</property><layout><property name="row">4</property><property name="column">0</property><property name="column-span">2</property></layout></object></child>
                    <child>
                      <object class="GtkBox" id="history_cleanup_box">
                        <property name="orientation">vertical</property><property name="spacing">8</property><property name="hexpand">true</property>
                        <layout><property name="row">5</property><property name="column">0</property><property name="column-span">2</property></layout>
                        <child><object class="GtkCheckButton" id="retain_completed_canceled_history_check"><property name="label">Keep completed and canceled records after restart</property><property name="tooltip-text">When enabled, keep completed and canceled records across restarts. When disabled, omit only those records from persisted history. Downloaded files are never deleted; automatic cleanup is controlled separately.</property></object></child>
                        <child><object class="GtkCheckButton" id="automatic_cleanup_check"><property name="label">Automatically remove old download records</property><property name="tooltip-text">Disabled by default. Cleanup removes records from ODM history only and never deletes downloaded files.</property></object></child>
