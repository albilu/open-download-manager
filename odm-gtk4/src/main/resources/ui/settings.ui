<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="GtkAdjustment" id="tor_check_interval_adjustment"><property name="lower">1</property><property name="upper">1440</property><property name="step-increment">1</property><property name="page-increment">5</property><property name="value">30</property></object>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkAdjustment" id="max_concurrent_adjustment">
    <property name="lower">1</property><property name="upper">20</property><property name="value">3</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="max_connections_adjustment">
    <property name="lower">1</property><property name="upper">64</property><property name="value">4</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="retry_limit_adjustment">
    <property name="lower">0</property><property name="upper">50</property><property name="value">5</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="retry_after_adjustment">
    <property name="lower">0</property><property name="upper">600</property><property name="value">0</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="download_speed_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">0</property><property name="step-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="upload_speed_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">0</property><property name="step-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="min_split_size_adjustment">
    <property name="lower">1</property><property name="upper">100</property><property name="value">10</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="max_peers_adjustment">
    <property name="lower">0</property><property name="upper">500</property><property name="value">55</property><property name="step-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="peer_speed_limit_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">50</property><property name="step-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="seed_time_adjustment">
    <property name="lower">1</property><property name="upper">10080</property><property name="value">60</property><property name="step-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="seed_ratio_adjustment">
    <property name="lower">0.1</property><property name="upper">1000</property><property name="value">1</property><property name="step-increment">0.1</property><property name="page-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="tracker_refresh_adjustment">
    <property name="lower">0</property><property name="upper">1440</property><property name="value">0</property><property name="step-increment">30</property>
  </object>
  <object class="GtkAdjustment" id="aria2_rpc_port_adjustment">
    <property name="lower">1</property><property name="upper">65535</property><property name="value">6801</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="httrack_max_total_size_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">1024</property><property name="step-increment">100</property><property name="page-increment">1024</property>
  </object>
  <object class="GtkAdjustment" id="httrack_max_non_html_size_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">100</property><property name="step-increment">10</property><property name="page-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="httrack_max_html_size_adjustment">
    <property name="lower">0</property><property name="upper">1048576</property><property name="value">10</property><property name="step-increment">1</property><property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="httrack_max_duration_adjustment">
    <property name="lower">0</property><property name="upper">525600</property><property name="value">60</property><property name="step-increment">10</property><property name="page-increment">60</property>
  </object>
  <object class="GtkAdjustment" id="httrack_max_links_adjustment">
    <property name="lower">0</property><property name="upper">10000000</property><property name="value">100000</property><property name="step-increment">1000</property><property name="page-increment">10000</property>
  </object>
  <object class="GtkAdjustment" id="httrack_connections_per_second_adjustment">
    <property name="lower">0</property><property name="upper">100</property><property name="value">5</property><property name="step-increment">0.5</property><property name="page-increment">5</property>
  </object>
  <object class="GtkAdjustment" id="httrack_delay_between_files_adjustment">
    <property name="lower">0</property><property name="upper">3600</property><property name="value">0</property><property name="step-increment">1</property><property name="page-increment">10</property>
  </object>
  <object class="GtkAdjustment" id="proxy_port_adjustment">
    <property name="lower">0</property><property name="upper">65535</property><property name="value">8080</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="cleanup_interval_adjustment">
    <property name="lower">1</property><property name="upper">8760</property><property name="value">24</property><property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="max_history_records_adjustment">
    <property name="lower">0</property><property name="upper">10000</property><property name="value">1000</property><property name="step-increment">100</property><property name="page-increment">500</property>
  </object>
  <object class="GtkAdjustment" id="max_completed_records_adjustment">
    <property name="lower">0</property><property name="upper">10000</property><property name="value">500</property><property name="step-increment">100</property><property name="page-increment">500</property>
  </object>
  <object class="GtkAdjustment" id="completed_retention_adjustment">
    <property name="lower">0</property><property name="upper">36500</property><property name="value">30</property><property name="step-increment">1</property><property name="page-increment">30</property>
  </object>
  <object class="GtkAdjustment" id="error_retention_adjustment">
    <property name="lower">0</property><property name="upper">36500</property><property name="value">7</property><property name="step-increment">1</property><property name="page-increment">30</property>
  </object>
  <object class="GtkAdjustment" id="max_import_urls_adjustment">
    <property name="lower">1</property><property name="upper">10000</property><property name="value">1000</property><property name="step-increment">100</property><property name="page-increment">500</property>
  </object>
  <object class="GtkAdjustment" id="max_import_source_size_adjustment">
    <property name="lower">1</property><property name="upper">64</property><property name="value">8</property><property name="step-increment">1</property><property name="page-increment">8</property>
  </object>
  <object class="GtkAdjustment" id="antivirus_timeout_adjustment">
    <property name="lower">0</property><property name="upper">86400</property><property name="value">600</property><property name="step-increment">30</property><property name="page-increment">300</property>
  </object>

  <object class="GtkWindow" id="settings_dialog">
    <property name="title">Open Download Manager - Settings</property>
    <property name="default-width">900</property>
    <property name="default-height">680</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <child>
          <object class="GtkNotebook" id="settings_notebook">
            <property name="vexpand">true</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>

            <!-- GENERAL -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="general_page">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkGrid" id="general_layout_grid">
                    <property name="hexpand">true</property><property name="vexpand">true</property>
                    <property name="column-homogeneous">true</property>
                    <property name="row-spacing">10</property><property name="column-spacing">24</property>
                    <property name="margin-start">12</property><property name="margin-end">12</property>
                    <property name="margin-top">14</property><property name="margin-bottom">14</property>
                    <child><object class="GtkLabel"><property name="label">Default download directory:</property><property name="xalign">0</property><property name="halign">start</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                    <child>
                      <object class="GtkBox" id="default_download_folder_stack">
                        <property name="orientation">vertical</property><property name="spacing">4</property><property name="hexpand">true</property>
                        <layout><property name="row">0</property><property name="column">1</property></layout>
                        <child><object class="GtkMenuButton" id="default_download_folder_chooser"><property name="label">Select folder…</property><property name="hexpand">true</property></object></child>
                        <child><object class="GtkLabel" id="available_space_label"><property name="halign">end</property><property name="xalign">1</property></object></child>
                      </object>
                    </child>
                    <child><object class="GtkLabel"><property name="label">Max concurrent downloads:</property><property name="xalign">0</property><property name="halign">start</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="max_concurrent_downloads_spin"><property name="adjustment">max_concurrent_adjustment</property><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Monitored folder:</property><property name="xalign">0</property><property name="halign">start</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkMenuButton" id="monitored_folder_chooser"><property name="label">Select monitored folder…</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                        <child>
                          <object class="GtkGrid" id="general_options_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property>
                            <layout><property name="row">3</property><property name="column">0</property><property name="column-span">2</property></layout>
                            <child><object class="GtkCheckButton" id="folder_monitoring_check"><property name="label">Enable folder monitoring</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="folder_recursive_check"><property name="label">Recursive</property><property name="margin-start">24</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="move_to_trash_check"><property name="label">Move processed watched descriptors to Trash</property><property name="margin-start">24</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="clipboard_monitor_check"><property name="label">Enable clipboard monitoring</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="clipboard_silent_check"><property name="label">Silent mode</property><property name="margin-start">24</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="system_tray_check"><property name="label">Enable system tray icon</property><layout><property name="row">5</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="startup_check"><property name="label">Start at login</property><layout><property name="row">6</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="start_automatically_check"><property name="label">Start downloads automatically</property><property name="tooltip-text">Applies to downloads detected by clipboard and folder monitoring</property><layout><property name="row">7</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="move_torrent_check"><property name="label">Move selected .torrent/.metalink/.meta4 descriptors to Trash</property><layout><property name="row">8</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkCheckButton" id="enable_auto_save_check"><property name="label">Enable auto save</property><property name="tooltip-text">Periodically save ODM download and session state</property><layout><property name="row">9</property><property name="column">0</property></layout></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab"><object class="GtkLabel"><property name="label">General</property></object></child>

            <!-- NETWORK -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="settings_box">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkGrid" id="options_columns_grid">
                    <property name="hexpand">true</property><property name="vexpand">true</property>
                    <property name="column-homogeneous">true</property><property name="column-spacing">20</property>
                    <property name="margin-start">12</property><property name="margin-end">12</property>
                    <property name="margin-top">14</property><property name="margin-bottom">14</property>
                    <child>
                      <object class="GtkBox" id="options_left_column">
                        <property name="orientation">vertical</property><property name="spacing">10</property><property name="hexpand">true</property>
                        <layout><property name="row">0</property><property name="column">0</property></layout>
                        <child><object class="GtkLabel" id="download_settings_heading"><property name="label">&lt;b&gt;Transfer Defaults&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property></object></child>
                        <child>
                          <object class="GtkGrid" id="settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Max Connections:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_connections_spin"><property name="adjustment">max_connections_adjustment</property><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry Limit:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_limit_spin"><property name="adjustment">retry_limit_adjustment</property><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Retry After (s):</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="retry_after"><property name="adjustment">retry_after_adjustment</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Download Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_download_speed_spin"><property name="adjustment">download_speed_adjustment</property><property name="hexpand">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel"><property name="label">Max Upload Speed (KB/s):</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="max_upload_speed_spin"><property name="adjustment">upload_speed_adjustment</property><property name="hexpand">true</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                        <child><object class="GtkLabel" id="http_connection_heading"><property name="label">&lt;b&gt;HTTP Defaults&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">4</property></object></child>
                        <child>
                          <object class="GtkGrid" id="http_connection_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel" id="proxy_host_label1"><property name="label">Referer:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="referer_entry"><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_username_label1"><property name="label">Cookie:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="cookie_entry"><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_password_label1"><property name="label">User Agent:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="user_agent_entry"><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="options_right_column">
                        <property name="orientation">vertical</property><property name="spacing">10</property><property name="hexpand">true</property>
                        <layout><property name="row">0</property><property name="column">1</property></layout>
                        <child><object class="GtkLabel" id="proxy_settings_heading"><property name="label">&lt;b&gt;Proxy Settings&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property></object></child>
                        <child>
                          <object class="GtkGrid" id="proxy_settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Proxy Type:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkDropDown" id="proxy_type_combo"><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_host_label"><property name="label">Proxy Host:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_host_entry"><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_port_label"><property name="label">Proxy Port:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSpinButton" id="proxy_port_spin"><property name="adjustment">proxy_port_adjustment</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_username_label"><property name="label">Username:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_username_entry"><property name="hexpand">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                            <child><object class="GtkLabel" id="proxy_password_label"><property name="label">Password:</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkEntry" id="proxy_password_entry"><property name="visibility">false</property><property name="hexpand">true</property><layout><property name="row">4</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                        <child><object class="GtkLabel" id="tor_settings_heading"><property name="label">&lt;b&gt;Tor Settings&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">4</property></object></child>
                        <child>
                          <object class="GtkGrid" id="tor_settings_grid">
                            <property name="hexpand">true</property><property name="column-homogeneous">true</property><property name="row-spacing">8</property><property name="column-spacing">12</property>
                            <child><object class="GtkLabel"><property name="label">Enable Tor:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                            <child><object class="GtkSwitch" id="tor_switch"><property name="halign">start</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab"><object class="GtkLabel"><property name="label">Network</property></object></child>

            <!-- ARIA2 -->
            <child>
              <object class="GtkScrolledWindow">
                <property name="hscrollbar-policy">never</property>
                <child>
                  <object class="GtkBox" id="aria2_page">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkGrid" id="aria2_layout_grid">
                    <property name="hexpand">true</property><property name="vexpand">true</property>
                    <property name="column-homogeneous">true</property><property name="row-spacing">10</property><property name="column-spacing">24</property>
                    <property name="margin-start">12</property><property name="margin-end">12</property>
                    <property name="margin-top">14</property><property name="margin-bottom">14</property>
                    <child><object class="GtkLabel"><property name="label">aria2 path:</property><property name="xalign">0</property><property name="halign">start</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkBox" id="aria2_path_box"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="hexpand">true</property><layout><property name="row">0</property><property name="column">1</property></layout><child><object class="GtkEntry" id="aria2_path_entry"><property name="hexpand">true</property></object></child><child><object class="GtkButton" id="browse_aria2_button"><property name="label">Browse</property></object></child></object></child>
                    <child><object class="GtkLabel"><property name="label">RPC port:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="aria2_rpc_port_spin"><property name="adjustment">aria2_rpc_port_adjustment</property><property name="hexpand">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Min split size (MB):</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="min_split_size_spin1"><property name="adjustment">min_split_size_adjustment</property><property name="hexpand">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">File allocation:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkDropDown" id="file_allocation_combo"><property name="hexpand">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Max peers:</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
