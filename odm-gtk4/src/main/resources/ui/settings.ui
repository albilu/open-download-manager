<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkAdjustment" id="max_concurrent_adjustment">
    <property name="lower">1</property>
    <property name="upper">20</property>
    <property name="value">3</property>
    <property name="step-increment">1</property>
  </object>
  <object class="GtkAdjustment" id="speed_limit_adjustment">
    <property name="lower">0</property>
    <property name="upper">1048576</property>
    <property name="value">0</property>
    <property name="step-increment">100</property>
  </object>
  <object class="GtkAdjustment" id="max_retries_adjustment">
    <property name="lower">0</property>
    <property name="upper">20</property>
    <property name="value">5</property>
    <property name="step-increment">1</property>
  </object>

  <object class="GtkWindow" id="settings_dialog">
    <property name="title">Settings</property>
    <property name="modal">true</property>
    <property name="default-width">600</property>
    <property name="default-height">420</property>
    <child>
      <object class="GtkBox">
        <property name="orientation">vertical</property>
        <property name="spacing">0</property>
        <child>
          <object class="GtkNotebook" id="settings_notebook">
            <property name="vexpand">true</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">12</property>

            <!-- GENERAL -->
            <child>
              <object class="GtkGrid">
                <property name="row-spacing">12</property>
                <property name="column-spacing">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Max concurrent downloads:</property>
                    <property name="xalign">0</property>
                    <layout><property name="row">0</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="max_concurrent_spin">
                    <property name="adjustment">max_concurrent_adjustment</property>
                    <layout><property name="row">0</property><property name="column">1</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Global speed limit (KB/s, 0 = unlimited):</property>
                    <property name="xalign">0</property>
                    <layout><property name="row">1</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="speed_limit_spin">
                    <property name="adjustment">speed_limit_adjustment</property>
                    <layout><property name="row">1</property><property name="column">1</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Download folder:</property>
                    <property name="xalign">0</property>
                    <layout><property name="row">2</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <layout><property name="row">2</property><property name="column">1</property></layout>
                    <child>
                      <object class="GtkLabel" id="download_dir_label">
                        <property name="xalign">0</property>
                        <property name="hexpand">true</property>
                        <property name="ellipsize">middle</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="download_dir_button">
                        <property name="label">Choose…</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label">General</property></object>
            </child>

            <!-- PROXY -->
            <child>
              <object class="GtkGrid">
                <property name="row-spacing">12</property>
                <property name="column-spacing">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="GtkCheckButton" id="global_proxy_check">
                    <property name="label">Use a global proxy</property>
                    <layout><property name="row">0</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkEntry" id="global_proxy_entry">
                    <property name="placeholder-text">http://user:pass@host:port</property>
                    <property name="hexpand">true</property>
                    <layout><property name="row">0</property><property name="column">1</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkSeparator">
                    <property name="orientation">horizontal</property>
                    <layout><property name="row">1</property><property name="column">0</property><property name="column-span">2</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="proxy_rotation_check">
                    <property name="label">Rotate proxies on rate limits (bypass restrictions)</property>
                    <layout><property name="row">2</property><property name="column">0</property><property name="column-span">2</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Proxy list file:</property>
                    <property name="xalign">0</property>
                    <layout><property name="row">3</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">8</property>
                    <layout><property name="row">3</property><property name="column">1</property></layout>
                    <child>
                      <object class="GtkEntry" id="proxy_list_entry">
                        <property name="hexpand">true</property>
                        <property name="placeholder-text">~/.config/odm/proxy-list.txt</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton" id="proxy_list_button">
                        <property name="label">Choose…</property>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel">
                    <property name="label">Max retries per download:</property>
                    <property name="xalign">0</property>
                    <layout><property name="row">4</property><property name="column">0</property></layout>
                  </object>
                </child>
                <child>
                  <object class="GtkSpinButton" id="max_retries_spin">
                    <property name="adjustment">max_retries_adjustment</property>
                    <layout><property name="row">4</property><property name="column">1</property></layout>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label">Proxy</property></object>
            </child>

            <!-- FEATURES -->
            <child>
              <object class="GtkBox">
                <property name="orientation">vertical</property>
                <property name="spacing">12</property>
                <property name="margin-start">12</property>
                <property name="margin-end">12</property>
                <property name="margin-top">12</property>
                <property name="margin-bottom">12</property>
                <child>
                  <object class="GtkCheckButton" id="clipboard_check">
                    <property name="label">Monitor clipboard for URLs</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="torrent_folder_check">
                    <property name="label">Watch download folder for .torrent files</property>
                  </object>
                </child>
                <child>
                  <object class="GtkCheckButton" id="metalink_folder_check">
                    <property name="label">Watch download folder for .metalink/.meta4 files</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab">
              <object class="GtkLabel"><property name="label">Features</property></object>
            </child>
          </object>
        </child>

        <child>
          <object class="GtkSeparator">
            <property name="orientation">horizontal</property>
          </object>
        </child>

        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property>
            <property name="spacing">8</property>
            <property name="halign">end</property>
            <property name="margin-start">12</property>
            <property name="margin-end">12</property>
            <property name="margin-top">8</property>
            <property name="margin-bottom">12</property>
            <child>
              <object class="GtkLabel" id="settings_status_label">
                <property name="hexpand">true</property>
                <property name="xalign">0</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="settings_cancel_button">
                <property name="label">Cancel</property>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="settings_save_button">
                <property name="label">Save</property>
                <property name="css-classes">['suggested-action']</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
