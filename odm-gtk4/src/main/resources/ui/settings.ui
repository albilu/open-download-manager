                    <child><object class="GtkLabel"><property name="label">Tor check:</property><property name="xalign">0</property><layout><property name="row">11</property><property name="column">0</property></layout></object></child>
                    <child>
                      <object class="GtkBox">
                        <property name="spacing">6</property>
                        <layout><property name="row">11</property><property name="column">1</property></layout>
                        <child><object class="GtkSwitch" id="tor_circuit_monitor_switch"><property name="active">false</property><property name="valign">center</property></object></child>
                        <child>
                          <object class="GtkBox" id="tor_check_interval_box">
                            <property name="spacing">6</property><property name="sensitive">false</property>
                            <child><object class="GtkLabel"><property name="label">Run every</property></object></child>
                            <child><object class="GtkSpinButton" id="tor_check_interval_spin"><property name="adjustment">tor_check_interval_adjustment</property><property name="numeric">true</property></object></child>
                            <child><object class="GtkLabel"><property name="label">min</property></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child><object class="GtkLabel"><property name="label">curl:</property><property name="xalign">0</property><layout><property name="row">12</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkBox" id="curl_path_box"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="hexpand">true</property><layout><property name="row">12</property><property name="column">1</property></layout><child><object class="GtkEntry" id="curl_path_entry"><property name="hexpand">true</property></object></child><child><object class="GtkButton" id="browse_curl_button"><property name="label">Browse</property></object></child></object></child>
                    <child><object class="GtkLabel"><property name="label">Subliminal:</property><property name="xalign">0</property><layout><property name="row">13</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkBox" id="subliminal_path_box"><property name="orientation">horizontal</property><property name="spacing">6</property><property name="hexpand">true</property><layout><property name="row">13</property><property name="column">1</property></layout><child><object class="GtkEntry" id="subliminal_path_entry"><property name="hexpand">true</property></object></child><child><object class="GtkButton" id="browse_subliminal_button"><property name="label">Browse</property></object></child></object></child>
                    <child><object class="GtkLabel" id="completion_tools_heading"><property name="label">&lt;b&gt;Completion Actions&lt;/b&gt;</property><property name="use-markup">true</property><property name="xalign">0</property><property name="margin-top">6</property><layout><property name="row">14</property><property name="column">0</property><property name="column-span">2</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Antivirus type:</property><property name="xalign">0</property><layout><property name="row">15</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkDropDown" id="antivirus_type_combo"><property name="hexpand">true</property><layout><property name="row">15</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel" id="antivirus_detection_label"><property name="xalign">0</property><property name="wrap">true</property><property name="css-classes">['dim-label']</property><layout><property name="row">16</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Custom antivirus command:</property><property name="xalign">0</property><layout><property name="row">17</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkEntry" id="antivirus_command_entry"><property name="hexpand">true</property><property name="placeholder-text">scanner --options {file}</property><layout><property name="row">17</property><property name="column">1</property></layout></object></child>
                    <child><object class="GtkLabel"><property name="label">Antivirus timeout (seconds):</property><property name="xalign">0</property><layout><property name="row">18</property><property name="column">0</property></layout></object></child>
                    <child><object class="GtkSpinButton" id="antivirus_timeout_spin"><property name="adjustment">antivirus_timeout_adjustment</property><property name="hexpand">true</property><layout><property name="row">18</property><property name="column">1</property></layout></object></child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child type="tab"><object class="GtkLabel"><property name="label">Advanced</property></object></child>
          </object>
        </child>

        <child><object class="GtkSeparator"><property name="orientation">horizontal</property></object></child>
        <child>
          <object class="GtkBox">
            <property name="orientation">horizontal</property><property name="spacing">8</property><property name="halign">end</property>
            <property name="margin-start">12</property><property name="margin-end">12</property><property name="margin-top">8</property><property name="margin-bottom">12</property>
            <child><object class="GtkLabel" id="settings_status_label"><property name="accessible-role">status</property><property name="hexpand">true</property><property name="xalign">0</property></object></child>
            <child><object class="GtkButton" id="settings_cancel_button"><property name="label">_Cancel</property><property name="use-underline">true</property></object></child>
            <child><object class="GtkButton" id="settings_reset_button"><property name="label">_Reset</property><property name="use-underline">true</property><property name="tooltip-text">Restore defaults for the currently selected tab only</property></object></child>
            <child><object class="GtkButton" id="settings_apply_button"><property name="label">_Apply</property><property name="use-underline">true</property></object></child>
            <child><object class="GtkButton" id="settings_ok_button"><property name="label">_OK</property><property name="use-underline">true</property><property name="css-classes">['suggested-action']</property></object></child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
