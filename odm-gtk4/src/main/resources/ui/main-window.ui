<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <!-- Stores (1:1 with original) -->
  <object class="GtkListStore" id="category_store">
    <columns><column type="gchararray"/><column type="gint"/><column type="gchararray"/></columns>
  </object>
  <object class="GtkListStore" id="download_store">
    <columns>
      <column type="gint"/>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gchararray"/><column type="GIcon"/>
      <column type="gint"/>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gint"/>
      <column type="gint64"/><column type="gint64"/><column type="gdouble"/>
      <column type="gint64"/><column type="gint64"/>
      <column type="gdouble"/><column type="gdouble"/>
      <column type="gint64"/><column type="gint64"/><column type="gint"/>
      <column type="gint"/>
    </columns>
  </object>
  <object class="GtkTreeStore" id="files_store">
    <columns>
      <column type="gboolean"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gint"/><column type="gchararray"/><column type="gint"/>
      <column type="gchararray"/><column type="gint64"/><column type="gdouble"/>
      <column type="gchararray"/><column type="gboolean"/><column type="gboolean"/>
      <column type="gint"/><column type="gchararray"/>
    </columns>
  </object>
  <object class="GtkListStore" id="files_priority_store">
    <columns><column type="gchararray"/></columns>
  </object>
  <object class="GtkListStore" id="completion_details_store">
    <columns>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gchararray"/><column type="gchararray"/><column type="gchararray"/>
      <column type="gboolean"/>
    </columns>
  </object>
  <object class="GtkListStore" id="global_progress_store">
    <columns><column type="gint"/><column type="gchararray"/></columns>
  </object>
  <object class="GtkListStore" id="peers_store">
    <columns><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/></columns>
  </object>
  <object class="GtkListStore" id="status_store">
    <columns><column type="gchararray"/><column type="gint"/><column type="gchararray"/></columns>
  </object>
  <object class="GtkListStore" id="trackers_store">
    <columns><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/><column type="gchararray"/></columns>
  </object>

  <!-- Main window -->
  <object class="GtkApplicationWindow" id="main_window">
    <property name="title">oDM</property>
    <property name="default-width">1100</property>
    <property name="default-height">640</property>
    <child>
      <object class="GtkBox" id="main_container">
        <property name="orientation">vertical</property>

        <!-- GTK4's supported classic menubar presentation. MainWindow attaches
             the existing Gio.Menu action model after loading the builder. -->
        <child>
          <object class="GtkPopoverMenuBar" id="menu_bar">
            <property name="hexpand">true</property>
            <property name="vexpand">false</property>
          </object>
        </child>

        <child>
          <object class="GtkPaned" id="main_paned">
            <property name="vexpand">true</property>
            <property name="position">210</property>

            <!-- LEFT PANEL: status + categories -->
            <property name="start-child">
              <object class="GtkBox" id="left_panel">
                <property name="orientation">vertical</property>
                <property name="spacing">6</property>
                <property name="margin-start">6</property>
                <property name="margin-end">6</property>
                <property name="margin-top">6</property>
                <property name="margin-bottom">6</property>
                <child>
                  <object class="GtkLabel" id="status_label">
                    <property name="label">&lt;b&gt;Status&lt;/b&gt;</property>
                    <property name="use-markup">true</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="status_scrolled_window">
                    <property name="vexpand">false</property>
                    <property name="propagate-natural-height">true</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">never</property>
                    <child>
                      <object class="GtkTreeView" id="status_treeview">
                        <property name="model">status_store</property>
                        <property name="headers-visible">false</property>
                        <child>
                          <object class="GtkTreeViewColumn" id="status_column">
                            <property name="expand">true</property>
                            <child><object class="GtkCellRendererPixbuf"/><attributes><attribute name="icon-name">0</attribute></attributes></child>
                            <child><object class="GtkCellRendererText" id="status_label_renderer"/><attributes><attribute name="text">2</attribute></attributes></child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="count_column">
                            <property name="sizing">fixed</property>
                            <property name="fixed-width">44</property>
                            <child><object class="GtkCellRendererText" id="status_count_renderer"><property name="xalign">1</property></object><attributes><attribute name="text">1</attribute></attributes></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkLabel" id="category_label">
                    <property name="label">&lt;b&gt;Categories&lt;/b&gt;</property>
                    <property name="use-markup">true</property>
                    <property name="xalign">0</property>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow" id="category_scrolled_window">
                    <property name="vexpand">true</property>
                    <property name="propagate-natural-height">true</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="vscrollbar-policy">never</property>
                    <child>
                      <object class="GtkTreeView" id="category_treeview">
                        <property name="model">category_store</property>
                        <property name="headers-visible">false</property>
                        <child>
                          <object class="GtkTreeViewColumn" id="category_column">
                            <property name="expand">true</property>
                            <child><object class="GtkCellRendererPixbuf"/><attributes><attribute name="icon-name">0</attribute></attributes></child>
                            <child><object class="GtkCellRendererText" id="category_label_renderer"/><attributes><attribute name="text">2</attribute></attributes></child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkTreeViewColumn" id="category_count_column">
                            <property name="sizing">fixed</property>
                            <property name="fixed-width">44</property>
                            <child><object class="GtkCellRendererText" id="category_count_renderer"><property name="xalign">1</property></object><attributes><attribute name="text">1</attribute></attributes></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </property>

            <!-- RIGHT PANEL: toolbar + content -->
            <property name="end-child">
              <object class="GtkBox" id="right_panel">
                <property name="orientation">vertical</property>

                <child>
                  <object class="GtkBox" id="download_toolbar">
                    <property name="orientation">horizontal</property>
                    <property name="spacing">6</property>
                    <property name="vexpand">false</property>
                    <style><class name="toolbar"/></style>
                    <child><object class="GtkButton" id="new_download_button"><property name="icon-name">list-add</property><property name="tooltip-text">New download</property></object></child>
                    <child><object class="GtkButton" id="pause_button"><property name="icon-name">media-playback-pause</property><property name="tooltip-text">Pause</property></object></child>
                    <child><object class="GtkButton" id="resume_button"><property name="icon-name">media-playback-start</property><property name="tooltip-text">Start / Resume</property></object></child>
                    <child><object class="GtkButton" id="delete_button"><property name="icon-name">edit-delete</property><property name="tooltip-text">Delete</property></object></child>
                    <child><object class="GtkSeparator"><property name="orientation">vertical</property></object></child>
                    <child><object class="GtkButton" id="move_up_button"><property name="icon-name">go-up</property><property name="tooltip-text">Move up</property></object></child>
                    <child><object class="GtkButton" id="move_top_button"><property name="icon-name">go-top</property><property name="tooltip-text">Move to top</property></object></child>
                    <child><object class="GtkButton" id="move_down_button"><property name="icon-name">go-down</property><property name="tooltip-text">Move down</property></object></child>
                    <child><object class="GtkButton" id="move_bottom_button"><property name="icon-name">go-bottom</property><property name="tooltip-text">Move to bottom</property></object></child>
                    <child><object class="GtkSeparator"><property name="orientation">vertical</property></object></child>
                    <child><object class="GtkButton" id="settings_button"><property name="icon-name">preferences-system-symbolic</property><property name="tooltip-text">Settings</property></object></child>
                    <child><object class="GtkSeparator"><property name="orientation">vertical</property></object></child>
                    <child>
                      <object class="GtkBox" id="tor_box">
                        <property name="spacing">4</property>
                        <child><object class="GtkImage" id="tor_icon"><property name="pixel-size">24</property><property name="tooltip-text">Tor service</property></object></child>
                        <child><object class="GtkSwitch" id="tor_switch"><property name="valign">center</property><property name="tooltip-text">Enable Tor network</property></object></child>
                      </object>
                    </child>
                    <child><object class="GtkSeparator"><property name="orientation">vertical</property></object></child>
                    <child><object class="GtkBox" id="toolbar_spacer"><property name="hexpand">true</property></object></child>
                    <child>
                      <object class="GtkBox" id="search_tool_item">
                        <child><object class="GtkSearchEntry" id="search_entry"><property name="placeholder-text">Search downloads…</property><property name="width-request">280</property><property name="halign">end</property></object></child>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="GtkPaned" id="content_paned">
                    <property name="vexpand">true</property>
                    <property name="orientation">vertical</property>
                    <property name="position">240</property>
                    <property name="resize-start-child">true</property>
                    <property name="resize-end-child">true</property>
                    <property name="start-child">
                      <object class="GtkBox" id="download_list_container">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkScrolledWindow" id="download_scrolled_window">
                            <property name="hexpand">true</property>
                            <property name="vexpand">true</property>
                            <child>
                              <object class="GtkTreeView" id="download_treeview">
                                <property name="model">download_store</property>
                                <child><object class="GtkTreeViewColumn" id="number_column"><property name="title">#</property><property name="sort-column-id">0</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">0</attribute></attributes></child></object></child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="status_icon_column">
                                    <property name="sizing">fixed</property>
                                    <property name="fixed-width">32</property>
                                    <property name="sort-column-id">16</property>
                                    <child><object class="GtkCellRendererPixbuf" id="status_icon_renderer"/><attributes><attribute name="icon-name">13</attribute></attributes></child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="name_column">
                                    <property name="title">Name</property>
                                    <property name="expand">true</property>
                                    <property name="resizable">true</property>
                                    <property name="min-width">220</property>
                                    <property name="max-width">420</property>
                                    <property name="sort-column-id">1</property>
                                    <child><object class="GtkCellRendererText" id="name_renderer"><property name="ellipsize">end</property></object><attributes><attribute name="text">1</attribute></attributes></child>
                                  </object>
                                </child>
                                <child><object class="GtkTreeViewColumn" id="complete_column"><property name="title">Complete</property><property name="sort-column-id">17</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">2</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="size_column"><property name="title">Size</property><property name="sort-column-id">18</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">3</attribute></attributes></child></object></child>
                                <child>
                                  <object class="GtkTreeViewColumn" id="percent_progress_column">
                                    <property name="title">Progress</property>
                                    <property name="sizing">fixed</property>
                                    <property name="fixed-width">120</property>
                                    <property name="min-width">110</property>
                                    <property name="max-width">160</property>
                                    <property name="resizable">true</property>
                                    <property name="sort-column-id">19</property>
                                    <child><object class="GtkCellRendererProgress" id="download_progress_renderer"/><attributes><attribute name="value">12</attribute><attribute name="text">14</attribute><attribute name="pulse">27</attribute></attributes></child>
                                  </object>
                                </child>
                                <child><object class="GtkTreeViewColumn" id="elapsed_column"><property name="title">Elapsed</property><property name="sort-column-id">20</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">4</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="left_column"><property name="title">Left</property><property name="sort-column-id">21</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">5</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="speed_column"><property name="title">Down speed</property><property name="sort-column-id">22</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">6</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="up_speed_column"><property name="title">Up speed</property><property name="sort-column-id">23</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">7</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="retry_column"><property name="title">Retry</property><property name="sort-column-id">8</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">8</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="start_date_column"><property name="title">Start date</property><property name="sort-column-id">24</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">9</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="end_date_column"><property name="title">End date</property><property name="sort-column-id">25</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">10</attribute></attributes></child></object></child>
                                <child><object class="GtkTreeViewColumn" id="tor_icon_column"><property name="title">Result</property><property name="sizing">fixed</property><property name="fixed-width">44</property><property name="sort-column-id">26</property><child><object class="GtkCellRendererPixbuf" id="engine_icon_renderer"/><attributes><attribute name="gicon">11</attribute></attributes></child></object></child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </property>
                    <property name="end-child">
                      <object class="GtkBox" id="info_panel_box">
                        <property name="orientation">vertical</property>
                        <property name="vexpand">true</property>
                        <child>
                          <object class="GtkNotebook" id="info_notebook">
                            <property name="vexpand">true</property>
                            <property name="tab-pos">bottom</property>
                            <child>
                              <object class="GtkBox" id="general_tab">
                                <property name="orientation">vertical</property>
                                <property name="spacing">6</property>
                                <property name="margin-start">8</property>
                                <property name="margin-end">8</property>
                                <property name="margin-top">8</property>
                                <property name="margin-bottom">8</property>
                                <child>
                                  <object class="GtkBox" id="progress_container">
                                    <child><object class="GtkProgressBar" id="info_progress_bar"><property name="hexpand">true</property><property name="show-text">true</property></object></child>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="general_columns">
                                    <property name="orientation">horizontal</property>
                                    <property name="homogeneous">true</property>
                                    <property name="spacing">8</property>
                                    <child>
                                      <object class="GtkFrame" id="information_frame">
                                        <property name="hexpand">true</property>
                                        <child type="label">
                                          <object class="GtkLabel">
                                            <property name="label">&lt;b&gt;Information&lt;/b&gt;</property>
                                            <property name="use-markup">true</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkGrid" id="general_info_grid">
                                            <property name="row-spacing">4</property>
                                            <property name="column-spacing">12</property>
                                            <property name="margin-start">8</property>
                                            <property name="margin-end">8</property>
                                            <property name="margin-top">8</property>
                                            <property name="margin-bottom">8</property>
                                            <child><object class="GtkLabel"><property name="label">Engine:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                                            <child>
                                              <object class="GtkBox" id="engine_value_box">
                                                <property name="orientation">horizontal</property>
                                                <property name="spacing">6</property>
                                                <property name="hexpand">true</property>
                                                <layout><property name="row">0</property><property name="column">1</property></layout>
                                                <child><object class="GtkImage" id="engine_icon"/></child>
                                                <child><object class="GtkLabel" id="engine_value"><property name="label">—</property><property name="xalign">0</property><property name="selectable">true</property></object></child>
                                              </object>
                                            </child>
                                            <child><object class="GtkLabel"><property name="label">Total size:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="total_size_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Added on:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="added_on_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Info hash:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="info_hash_v1_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Save folder:</property><property name="xalign">0</property><layout><property name="row">4</property><property name="column">0</property></layout></object></child>
                                            <child>
                                              <object class="GtkButton" id="folder_open_button">
                                                <property name="sensitive">false</property>
                                                <property name="hexpand">true</property>
                                                <property name="halign">fill</property>
                                                <property name="tooltip-text">Open the download folder</property>
                                                <style><class name="flat"/></style>
                                                <layout><property name="row">4</property><property name="column">1</property></layout>
                                                <child>
                                                  <object class="GtkBox" id="folder_open_content">
                                                    <property name="orientation">horizontal</property>
                                                    <property name="spacing">6</property>
                                                    <child><object class="GtkImage"><property name="icon-name">folder-open-symbolic</property></object></child>
                                                    <child><object class="GtkLabel" id="folder_value"><property name="label">—</property><property name="xalign">0</property><property name="hexpand">true</property><property name="ellipsize">end</property></object></child>
                                                  </object>
                                                </child>
                                              </object>
                                            </child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkFrame" id="transfer_frame">
                                        <property name="hexpand">true</property>
                                        <child type="label">
                                          <object class="GtkLabel">
                                            <property name="label">&lt;b&gt;Transfer&lt;/b&gt;</property>
                                            <property name="use-markup">true</property>
                                            <property name="xalign">0</property>
                                          </object>
                                        </child>
                                        <child>
                                          <object class="GtkGrid" id="transfer_info_grid">
                                            <property name="row-spacing">4</property>
                                            <property name="column-spacing">12</property>
                                            <property name="margin-start">8</property>
                                            <property name="margin-end">8</property>
                                            <property name="margin-top">8</property>
                                            <property name="margin-bottom">8</property>
                                            <child><object class="GtkLabel"><property name="label">ETA:</property><property name="xalign">0</property><layout><property name="row">0</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="eta_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">0</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Downloaded:</property><property name="xalign">0</property><layout><property name="row">1</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="downloaded_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">1</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Connections:</property><property name="xalign">0</property><layout><property name="row">2</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="connections_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">2</property><property name="column">1</property></layout></object></child>
                                            <child><object class="GtkLabel"><property name="label">Seeds/peers:</property><property name="xalign">0</property><layout><property name="row">3</property><property name="column">0</property></layout></object></child>
                                            <child><object class="GtkLabel" id="seeds_peers_value"><property name="xalign">0</property><property name="selectable">true</property><layout><property name="row">3</property><property name="column">1</property></layout></object></child>
                                          </object>
                                        </child>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="tab"><object class="GtkLabel"><property name="label">General</property></object></child>

                            <child>
                              <object class="GtkScrolledWindow" id="completion_details_scrolled">
                                <child>
                                  <object class="GtkTreeView" id="completion_details_view">
                                    <property name="model">completion_details_store</property>
                                    <child><object class="GtkTreeViewColumn" id="completion_action_column"><property name="title">Action</property><property name="resizable">true</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">0</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="completion_status_column"><property name="title">Status</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">1</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="completion_result_column"><property name="title">Result</property><property name="expand">true</property><property name="resizable">true</property><child><object class="GtkCellRendererText"><property name="ellipsize">end</property></object><attributes><attribute name="text">2</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="completion_started_column"><property name="title">Started</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">3</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="completion_finished_column"><property name="title">Finished</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">4</attribute></attributes></child></object></child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="tab"><object class="GtkLabel" id="actions_tab_label"><property name="label">Actions</property></object></child>

                            <child>
                              <object class="GtkScrolledWindow" id="trackers_scrolled">
                                <child>
                                  <object class="GtkTreeView" id="trackers_view">
                                    <property name="model">trackers_store</property>
                                    <child><object class="GtkTreeViewColumn" id="url_column"><property name="title">URL</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">0</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="status_column1"><property name="title">Status</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">1</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="seeders_column"><property name="title">Seeders</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">2</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="leechers_column"><property name="title">Leechers</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">3</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="times_downlo_column"><property name="title">Downloads</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">4</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="next_update_column"><property name="title">Next update</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">5</attribute></attributes></child></object></child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="tab"><object class="GtkLabel"><property name="label">Trackers</property></object></child>

                            <child>
                              <object class="GtkScrolledWindow" id="peers_scrolled">
                                <child>
                                  <object class="GtkTreeView" id="peers_view">
                                    <property name="model">peers_store</property>
                                    <child><object class="GtkTreeViewColumn" id="country_column"><property name="title">Address</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">0</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="drapeaux_column"><property name="title">Peer ID</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">1</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="adresse_column"><property name="title">Down speed</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">2</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="client_column"><property name="title">Up speed</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">3</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="peer_state_column"><property name="title">State</property><child><object class="GtkCellRendererText"/><attributes><attribute name="text">4</attribute></attributes></child></object></child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="tab"><object class="GtkLabel"><property name="label">Peers</property></object></child>

                            <child>
                              <object class="GtkScrolledWindow" id="files_scrolled">
                                <child>
                                  <object class="GtkTreeView" id="files_view">
                                    <property name="model">files_store</property>
                                    <property name="enable-tree-lines">true</property>
                                    <child><object class="GtkTreeViewColumn" id="files_selected_column"><property name="title">Sel.</property><property name="sort-column-id">0</property><child><object class="GtkCellRendererToggle" id="files_selected_renderer"><property name="activatable">true</property></object><attributes><attribute name="active">0</attribute><attribute name="inconsistent">11</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="files_name_column"><property name="title">Name</property><property name="expand">true</property><property name="resizable">true</property><property name="min-width">160</property><property name="max-width">420</property><property name="sort-column-id">1</property><child><object class="GtkCellRendererPixbuf" id="files_icon_renderer"/><attributes><attribute name="icon-name">13</attribute></attributes></child><child><object class="GtkCellRendererText" id="files_name_renderer"><property name="ellipsize">end</property></object><attributes><attribute name="text">1</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="files_size_column"><property name="title">Size</property><property name="sort-column-id">7</property><child><object class="GtkCellRendererText" id="files_size_renderer"/><attributes><attribute name="text">2</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="files_progress_column"><property name="title">Progress</property><property name="sort-column-id">8</property><child><object class="GtkCellRendererProgress" id="files_progress_renderer"/><attributes><attribute name="value">3</attribute><attribute name="text">6</attribute></attributes></child></object></child>
                                    <child><object class="GtkTreeViewColumn" id="files_priority_column"><property name="title">Priority</property><property name="sort-column-id">12</property><child><object class="GtkCellRendererCombo" id="files_priority_renderer"><property name="model">files_priority_store</property><property name="text-column">0</property><property name="has-entry">false</property><property name="editable">true</property></object><attributes><attribute name="text">4</attribute></attributes></child></object></child>
                                  </object>
                                </child>
                              </object>
                            </child>
                            <child type="tab"><object class="GtkLabel"><property name="label">Files</property></object></child>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </property>
          </object>
        </child>

        <child>
          <object class="GtkBox" id="statusbar_box">
            <property name="orientation">horizontal</property>
            <property name="vexpand">false</property>
            <property name="spacing">8</property>
            <property name="margin-start">6</property>
            <property name="margin-end">6</property>
            <property name="margin-top">4</property>
            <property name="margin-bottom">4</property>
            <child>
              <object class="GtkBox" id="statusbar">
                <property name="orientation">horizontal</property>
                <property name="hexpand">true</property>
                <child>
                  <object class="GtkBox" id="statusbar_content_box">
                    <property name="orientation">horizontal</property>
                    <property name="hexpand">true</property>
                    <child><object class="GtkLabel" id="info_label"><property name="accessible-role">status</property><property name="label">Ready</property><property name="xalign">0</property><property name="hexpand">true</property></object></child>
                    <child>
                      <object class="GtkBox" id="statusbar_right_box">
                        <property name="orientation">horizontal</property>
                        <property name="spacing">8</property>
                        <property name="halign">end</property>
                        <child><object class="GtkSpinner" id="activity_spinner"/></child>
                        <child><object class="GtkSeparator" id="dht_inner_separator"/></child>
                        <child>
                          <object class="GtkBox" id="dht_progress_box">
                            <child><object class="GtkLabel" id="dht_status_label"><property name="label">DHT: —</property></object></child>
                          </object>
                        </child>
                        <child><object class="GtkSeparator" id="dht_separator"/></child>
                        <child>
                          <object class="GtkBox" id="upload_speed_box">
                            <child><object class="GtkImage" id="upload_speed_icon"><property name="icon-name">go-up-symbolic</property></object></child>
                            <child><object class="GtkLabel" id="up_speed_label"><property name="label">0 B/s</property></object></child>
                          </object>
                        </child>
                        <child><object class="GtkSeparator" id="upload_separator"/></child>
                        <child>
                          <object class="GtkBox" id="download_speed_box">
                            <child><object class="GtkImage" id="download_speed_icon"><property name="icon-name">go-down-symbolic</property></object></child>
                            <child><object class="GtkLabel" id="down_speed_label"><property name="label">0 B/s</property></object></child>
                          </object>
                        </child>
                        <child><object class="GtkSeparator" id="download_separator"/></child>
                        <child>
                          <object class="GtkTreeView" id="global_progress_tree">
                            <property name="model">global_progress_store</property>
                            <property name="headers-visible">false</property>
                            <property name="width-request">180</property>
                            <property name="height-request">22</property>
                            <child><object class="GtkTreeViewColumn" id="global_progress_column"><child><object class="GtkCellRendererProgress" id="global_progress_renderer"/><attributes><attribute name="value">0</attribute><attribute name="text">1</attribute></attributes></child></object></child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
